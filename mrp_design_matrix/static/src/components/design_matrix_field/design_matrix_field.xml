<templates xml:space="preserve">

    <t t-name="mrp_design_matrix.DesignMatrixField">
        <div class="o_dmn_field">
            <!-- Empty state -->
            <t t-if="isEmpty">
                <div class="o_dmn_empty text-muted fst-italic p-2">
                    No decision table loaded.
                </div>
            </t>

            <!-- Table has data but no rules -->
            <t t-elif="!hasData and table">
                <div class="o_dmn_wrapper">
                    <div class="o_dmn_header" t-on-click="toggleCollapse">
                        <i t-attf-class="fa fa-fw #{state.collapsed ? 'fa-chevron-right' : 'fa-chevron-down'}"/>
                        <span class="o_dmn_table_name" t-out="tableName"/>
                        <span t-attf-class="o_dmn_hp_badge #{hitPolicyClass}" t-out="hitPolicyLabel"/>
                    </div>
                    <div class="o_dmn_empty_rules text-muted fst-italic p-2" t-if="!state.collapsed">
                        Table defined but no rules yet.
                    </div>
                </div>
            </t>

            <!-- Full table render -->
            <t t-elif="hasData">
                <div class="o_dmn_wrapper">
                    <!-- Header bar -->
                    <div class="o_dmn_header" t-on-click="toggleCollapse">
                        <i t-attf-class="fa fa-fw #{state.collapsed ? 'fa-chevron-right' : 'fa-chevron-down'}"/>
                        <span class="o_dmn_table_name" t-out="tableName"/>
                        <span t-attf-class="o_dmn_hp_badge #{hitPolicyClass}" t-out="hitPolicyLabel"/>
                        <span class="o_dmn_rule_count text-muted ms-auto">
                            <t t-out="rules.length"/> rule<t t-if="rules.length !== 1">s</t>
                        </span>
                    </div>

                    <!-- Decision table -->
                    <table class="o_dmn_table" t-if="!state.collapsed">
                        <thead>
                            <!-- Category row -->
                            <tr class="o_dmn_cat_row">
                                <th class="o_dmn_row_num">#</th>
                                <th t-attf-class="o_dmn_cat_input"
                                    t-att-colspan="inputs.length"
                                    t-if="inputs.length">
                                    INPUTS
                                </th>
                                <th t-attf-class="o_dmn_cat_output"
                                    t-att-colspan="outputs.length"
                                    t-if="outputs.length">
                                    OUTPUTS
                                </th>
                            </tr>
                            <!-- Column names -->
                            <tr class="o_dmn_col_row">
                                <th class="o_dmn_row_num"/>
                                <t t-foreach="inputs" t-as="inp" t-key="inp.id">
                                    <th class="o_dmn_col_input" t-out="inp.name"/>
                                </t>
                                <t t-foreach="outputs" t-as="out" t-key="out.id">
                                    <th class="o_dmn_col_output" t-out="out.name"/>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rules" t-as="rule" t-key="rule_index">
                                <tr class="o_dmn_rule_row">
                                    <td class="o_dmn_row_num">
                                        <t t-out="rule_index + 1"/>
                                    </td>
                                    <t t-foreach="getRuleCells(rule)" t-as="cell" t-key="cell_index">
                                        <td t-attf-class="#{cell.isInput ? 'o_dmn_cell_input' : 'o_dmn_cell_output'} #{cell.cssClass}"
                                            t-att-title="cell.title or false">
                                            <t t-if="cell.badgeClass">
                                                <span t-attf-class="o_dmn_level_badge #{cell.badgeClass}"
                                                      t-out="cell.display"/>
                                            </t>
                                            <t t-else="">
                                                <t t-out="cell.display"/>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>

</templates>
