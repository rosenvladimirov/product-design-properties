<templates xml:space="preserve">

    <t t-name="mrp_design_matrix.InlineMatrixPreview">
        <t t-if="hasMatrix">
            <div class="o_inline_matrix_preview">

                <!-- Collapsible header -->
                <div class="o_inline_mp_header" t-on-click="toggleCollapsed">
                    <i t-attf-class="fa #{state.collapsed ? 'fa-caret-right' : 'fa-caret-down'} me-1"/>
                    <strong>Constraint Preview</strong>
                </div>

                <t t-if="state.loading">
                    <div class="text-center py-3">
                        <i class="fa fa-spinner fa-spin text-muted"/>
                    </div>
                </t>

                <t t-elif="!state.collapsed">
                    <div class="o_inline_mp_body">

                        <!-- Left panel: parameter controls -->
                        <div class="o_inline_mp_params">
                            <div class="o_inline_mp_params_title text-muted small mb-2">Parameters</div>

                            <t t-foreach="displayParams" t-as="param" t-key="param.key">

                                <!-- Float slider -->
                                <t t-if="param.type === 'float'">
                                    <div class="o_mp_param_row">
                                        <div class="o_mp_param_label">
                                            <span><t t-esc="param.string || param.name"/></span>
                                            <strong><t t-esc="param.value"/></strong>
                                        </div>
                                        <input type="range"
                                               t-att-min="param.min || 0"
                                               t-att-max="param.max || 9999"
                                               t-att-step="param.step || 1"
                                               t-att-value="param.value"
                                               t-att-data-param="param.key"
                                               t-on-input="onSliderInput"/>
                                        <input type="number"
                                               class="o_mp_spinner"
                                               t-att-min="param.min || 0"
                                               t-att-max="param.max || 9999"
                                               step="1"
                                               t-att-value="param.value"
                                               t-att-data-param="param.key"
                                               t-on-input="onSpinnerInput"/>
                                    </div>
                                </t>

                                <!-- Selection -->
                                <t t-if="param.type === 'selection' and param.selection">
                                    <div class="o_mp_param_row">
                                        <div class="o_mp_param_label">
                                            <span><t t-esc="param.string || param.name"/></span>
                                        </div>
                                        <div class="o_mp_seg">
                                            <t t-foreach="param.selection" t-as="opt" t-key="opt[0]">
                                                <button t-att-class="'o_mp_seg_btn' + (params[param.key] === opt[0] ? ' active' : '')"
                                                        t-att-data-value="opt[0]"
                                                        t-att-data-param="param.key"
                                                        t-on-click="onSegmentClick">
                                                    <t t-esc="opt[1]"/>
                                                </button>
                                            </t>
                                        </div>
                                    </div>
                                </t>

                                <!-- Boolean -->
                                <t t-if="param.type === 'boolean'">
                                    <label class="o_mp_check">
                                        <input type="checkbox"
                                               t-att-checked="params[param.key]"
                                               t-att-data-param="param.key"
                                               t-on-change="onCheckChange"/>
                                        <span><t t-esc="param.string || param.name"/></span>
                                    </label>
                                </t>

                                <!-- Char -->
                                <t t-if="param.type === 'char'">
                                    <div class="o_mp_param_row">
                                        <div class="o_mp_param_label">
                                            <span><t t-esc="param.string || param.name"/></span>
                                        </div>
                                        <input type="text" class="o_input o_mp_text"
                                               t-att-value="params[param.key]"
                                               t-att-data-param="param.key"
                                               t-on-change="onTextChange"/>
                                    </div>
                                </t>

                            </t>

                            <div class="text-muted fst-italic small"
                                 t-if="!displayParams.length">
                                No design parameter definition linked.
                            </div>
                        </div>

                        <!-- Right panel: RuleMatrixPreview -->
                        <div class="o_inline_mp_results">
                            <RuleMatrixPreview
                                params="params"
                                paramsVersion="state.paramsVersion"
                                constraintTable="constraintTable"
                                geometryTable="geometryTable"
                                materialTable="materialTable"
                                operationTable="operationTable"
                                bomLines="state.bomLines"
                            />
                        </div>

                    </div>
                </t>

            </div>
        </t>
    </t>

</templates>
