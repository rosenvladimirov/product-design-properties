<templates xml:space="preserve">

    <t t-name="mrp_design_matrix.MatrixPreviewButton">
        <t t-if="hasMatrix">
            <button class="oe_stat_button" t-on-click="onClick">
                <i class="o_button_icon fa fa-fw fa-th"/>
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value"><t t-out="ruleCount"/></span>
                    <span class="o_stat_text">Matrix Rules</span>
                </div>
            </button>
        </t>
        <t t-else="">
            <div class="d-none"/>
        </t>
    </t>

</templates>
