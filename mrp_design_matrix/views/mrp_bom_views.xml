<odoo>
    <record id="mrp_bom_form_view_design_matrix" model="ir.ui.view">
        <field name="name">mrp.bom.form.design.matrix</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <!-- Matrix Preview smart button -->
            <div name="button_box" position="inside">
                <field name="id" widget="matrix_preview_button" nolabel="1"/>
            </div>

            <notebook position="inside">
                <page string="Design Matrix" name="design_matrix">
                    <group>
                        <group string="Configuration">
                            <field name="matrix_template_id"/>
                            <button name="action_load_from_template"
                                    string="Load from Template"
                                    type="object"
                                    icon="fa-download"
                                    invisible="not matrix_template_id"/>
                        </group>
                    </group>

                    <field name="constraint_table"
                           widget="design_matrix"
                           options="{'table_type': 't0'}"
                           nolabel="1"/>

                    <field name="geometry_table"
                           widget="design_matrix"
                           options="{'table_type': 't1'}"
                           nolabel="1"/>

                    <field name="material_table"
                           widget="design_matrix"
                           options="{'table_type': 't2'}"
                           nolabel="1"/>

                    <field name="operation_table"
                           widget="design_matrix"
                           options="{'table_type': 't3'}"
                           nolabel="1"/>

                    <field name="availability_table"
                           widget="design_matrix"
                           options="{'table_type': 'tpi'}"
                           nolabel="1"/>

                    <field name="cascade_table"
                           widget="design_matrix"
                           options="{'table_type': 'tphi'}"
                           nolabel="1"/>

                    <field name="multiplicity_table"
                           widget="design_matrix"
                           options="{'table_type': 'tomega'}"
                           nolabel="1"/>

                    <field name="layout_table"
                           widget="design_matrix"
                           options="{'table_type': 'tlambda'}"
                           nolabel="1"/>
                </page>
            </notebook>

        </field>
    </record>

    <!-- Extend BoM line tree with matrix fields -->
    <record id="mrp_bom_line_tree_design_matrix" model="ir.ui.view">
        <field name="name">mrp.bom.line.tree.design.matrix</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
        <field name="arch" type="xml">
            <field name="product_qty" position="after">
                <field name="coeff_default" optional="hide"/>
            </field>
            <field name="product_qty" position="after">
                <field name="matrix_coeff_rule" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Extend BoM line form -->
    <record id="mrp_bom_line_form_design_matrix" model="ir.ui.view">
        <field name="name">mrp.bom.line.form.design.matrix</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook>
                    <page string="Design Matrix" name="bom_line_matrix">
                    <group string="Coefficient">
                        <field name="coeff_default"/>
                        <field name="matrix_coeff_rule"/>
                    </group>
                    <group string="PTAV Resolution">
                        <field name="product_tmpl_id"/>
                        <field name="param_attribute_map"
                               widget="ace"
                               options="{'mode': 'json'}"
                               invisible="not product_tmpl_id"/>
                    </group>
                    <group string="Semi-finished Chain">
                        <field name="child_definition_id"/>
                        <field name="mto_stop"/>
                        <field name="param_extraction_map"
                               widget="ace"
                               options="{'mode': 'json'}"
                               invisible="not child_definition_id"/>
                    </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

</odoo>
