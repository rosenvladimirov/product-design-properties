<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_matrix_template_view_list" model="ir.ui.view">
        <field name="name">mrp.matrix.template.list</field>
        <field name="model">mrp.matrix.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="industry_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="mrp_matrix_template_view_form" model="ir.ui.view">
        <field name="name">mrp.matrix.template.form</field>
        <field name="model">mrp.matrix.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="industry_id"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="T0 — Constraints">
                            <field name="constraint_table"
                                   widget="design_matrix"
                                   options="{'table_type': 't0'}"
                                   nolabel="1"/>
                        </page>
                        <page string="T1 — Geometry">
                            <field name="geometry_table"
                                   widget="design_matrix"
                                   options="{'table_type': 't1'}"
                                   nolabel="1"/>
                        </page>
                        <page string="T2 — Materials">
                            <field name="material_table"
                                   widget="design_matrix"
                                   options="{'table_type': 't2'}"
                                   nolabel="1"/>
                        </page>
                        <page string="T3 — Operations">
                            <field name="operation_table"
                                   widget="design_matrix"
                                   options="{'table_type': 't3'}"
                                   nolabel="1"/>
                        </page>
                        <page string="TΠ — Availability">
                            <div class="alert alert-info" role="alert">
                                <strong>Reactive UI control table.</strong>
                                Consumed от sale_design_configurator на всяка
                                промяна на param. Outputs: <code>param</code>,
                                <code>visible</code>, <code>enabled</code>,
                                <code>allowed_values</code>,
                                <code>default_override</code>.
                            </div>
                            <field name="availability_table"
                                   widget="design_matrix"
                                   options="{'table_type': 'tpi'}"
                                   nolabel="1"/>
                        </page>
                        <page string="TΛ — Layout">
                            <div class="alert alert-info" role="alert">
                                <strong>UX hints per param.</strong>
                                Outputs: <code>param</code>, <code>section</code>
                                (групиране в UI), <code>widget_hint</code>
                                (segment/spinner/slider/color_picker),
                                <code>customer_visible</code> (bool — customer-pickable
                                vs internal), <code>submodal</code> (sub-modal id),
                                <code>order</code> (ordering hint).
                            </div>
                            <field name="layout_table"
                                   widget="design_matrix"
                                   options="{'table_type': 'tlambda'}"
                                   nolabel="1"/>
                        </page>
                        <page string="TΩ — Multiplicity">
                            <div class="alert alert-info" role="alert">
                                <strong>Multi-instance metadata.</strong>
                                Declarative описание на multi-shutter / multi-door /
                                multi-shelf продукти. Outputs: <code>count_param</code>
                                (param с N), <code>per_instance_params</code>
                                (list — кои params са per-instance), <code>aggregator</code>
                                (sum/list/concat), <code>skip_when</code> (optional
                                expression да skip multiplicity).
                            </div>
                            <field name="multiplicity_table"
                                   widget="design_matrix"
                                   options="{'table_type': 'tomega'}"
                                   nolabel="1"/>
                        </page>
                        <page string="TΦ — Cascade">
                            <div class="alert alert-info" role="alert">
                                <strong>Reactive value propagation.</strong>
                                Когато <code>changed_param</code> се промени →
                                derive стойност за <code>target_param</code>.
                                Outputs: <code>copy_from</code> (друг param чиято
                                стойност копираме), <code>derive_value</code>
                                (explicit стойност), <code>derive_expression</code>
                                (safe_eval с current params + <code>lookup()</code>
                                helper), <code>only_if_empty</code> (bool — не
                                overwrite-вай user choice).
                            </div>
                            <field name="cascade_table"
                                   widget="design_matrix"
                                   options="{'table_type': 'tphi'}"
                                   nolabel="1"/>
                        </page>
                        <page string="Lookup Tables">
                            <div class="alert alert-secondary" role="alert">
                                Named lookup таблици достъпни от TΦ
                                <code>derive_expression</code> rules чрез
                                <code>lookup(name, key1, key2, ...)</code>.
                                Структура: <code>{table_name: {key1: {key2: [[threshold, result], ...]}}}</code>.
                                За ordered numeric matching (напр. box-by-height):
                                inner стойност = list of [threshold, result]
                                ordered ascending.
                            </div>
                            <field name="lookup_tables"
                                   widget="ace"
                                   options="{'mode': 'json'}"
                                   nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_matrix_template_action" model="ir.actions.act_window">
        <field name="name">Matrix Templates</field>
        <field name="res_model">mrp.matrix.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mrp_matrix_template"
              name="Matrix Templates"
              parent="mrp.menu_mrp_configuration"
              action="mrp_matrix_template_action"
              sequence="51"/>
</odoo>
