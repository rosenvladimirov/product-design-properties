<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_lot_form_design_matrix" model="ir.ui.view">
        <field name="name">stock.lot.form.design.matrix</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="design_param_definition_id"/>
            </field>
            <notebook position="inside">
                <page string="Design Parameters"
                      attrs="{'invisible': [('design_param_definition_id', '=', False)]}">
                    <field name="design_params" nolabel="1"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
