<odoo>

    <record id="formula_editor_wizard_form_claude" model="ir.ui.view">
        <field name="name">mrp.bom.line.formula.wizard.form.claude</field>
        <field name="model">mrp.bom.line.formula.wizard</field>
        <field name="inherit_id" ref="mrp_bom_line_formula_wizard.formula_editor_wizard_form"/>
        <field name="arch" type="xml">

            <!-- Invisible fields: Claude reads these via RPC -->
            <field name="formula_template_id" position="after">
                <field name="claude_brief" invisible="1"/>
                <field name="claude_instructions" invisible="1"/>
            </field>

            <!-- Add Ask Claude button before the formula editor -->
            <field name="quantity_formula" position="before">
                <div class="d-flex justify-content-end mb-2">
                    <field name="claude_trigger"
                           widget="claude_formula_button"
                           nolabel="1"/>
                </div>
            </field>

        </field>
    </record>

</odoo>
