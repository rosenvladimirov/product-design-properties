{
  "nodes": [
    {
      "id": "t0-roller",
      "name": "T0 Constraints",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "slat_type",  "name": "slat_type"},
          {"id": "drive_type", "name": "drive_type"},
          {"id": "width",      "name": "width"},
          {"id": "height",     "name": "height"},
          {"id": "has_insulation", "name": "has_insulation"}
        ],
        "outputs": [
          {"id": "level",   "name": "level"},
          {"id": "message", "name": "message"}
        ],
        "rules": [
          {
            "slat_type": "\"PC\"",
            "drive_type": "",
            "width": "",
            "height": "",
            "has_insulation": "true",
            "level": "\"error\"",
            "message": "\"Поликарбонатните ламели не могат да имат изолация.\""
          },
          {
            "slat_type": "",
            "drive_type": "\"manual\"",
            "width": "> 3000",
            "height": "",
            "has_insulation": "",
            "level": "\"warning\"",
            "message": "\"Ширина > 3000 мм с ръчно управление — препоръчва се ел. мотор.\""
          },
          {
            "slat_type": "",
            "drive_type": "",
            "width": "> 3300",
            "height": "",
            "has_insulation": "",
            "level": "\"error\"",
            "message": "\"Максимална ширина 3300 мм.\""
          },
          {
            "slat_type": "",
            "drive_type": "",
            "width": "",
            "height": "> 2800",
            "has_insulation": "",
            "level": "\"error\"",
            "message": "\"Максимална височина 2800 мм.\""
          },
          {
            "slat_type": "",
            "drive_type": "",
            "width": "< 500",
            "height": "",
            "has_insulation": "",
            "level": "\"error\"",
            "message": "\"Минимална ширина 500 мм.\""
          }
        ]
      }
    },
