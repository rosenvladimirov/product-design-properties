  <!-- Insulation kit [insulation-o] -->
  <record id="bl_rs_insulation" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_insulation"/>
    <field name="product_qty">1.0</field>
