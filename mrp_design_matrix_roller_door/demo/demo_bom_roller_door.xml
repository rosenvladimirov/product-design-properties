  <!-- Caps: 1 per slat = slat_count -->
  <record id="bl_rs_caps" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_caps"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
import math
box_mm = int(box_size)
quantity = math.ceil((height - box_mm / 2) / slat_height_mm) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Ball Bearing: 2 pcs (without motor — with motor uses different type, handled as O-variant) -->
