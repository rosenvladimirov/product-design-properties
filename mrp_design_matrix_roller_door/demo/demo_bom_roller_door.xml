  <record id="product_roller_shutter" model="product.product">
    <field name="product_tmpl_id" ref="product_tmpl_roller_shutter"/>
  </record>

  <!-- ── Demo BoM ──────────────────────────────────────────────────────── -->
  <record id="bom_roller_shutter_standard" model="mrp.bom">
    <field name="product_tmpl_id" ref="product_tmpl_roller_shutter"/>
    <field name="product_qty">1</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="type">normal</field>
    <field name="design_param_definition_id"
           ref="mrp_design_matrix_roller_door.roller_door"/>
    <field name="matrix_template_id"
           ref="matrix_template_roller_shutter"/>
    <field name="constraint_table" eval="
        ref('matrix_template_roller_shutter').constraint_table
    "/>
    <field name="geometry_table" eval="
        ref('matrix_template_roller_shutter').geometry_table
    "/>
    <field name="material_table" eval="
        ref('matrix_template_roller_shutter').material_table
    "/>
    <field name="operation_table" eval="
        ref('matrix_template_roller_shutter').operation_table
    "/>
  </record>

  <!-- ── BoM lines ─────────────────────────────────────────────────────── -->

  <!-- AL Guide: 2 × (height - box_mm) / 1000 m  [box_size is string "165" → int=165] -->
  <record id="bl_rs_al_guide" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_al_guide"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
box_mm = int(box_size)
quantity = 2 * (height - box_mm) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Brush Guide: AL Guide × 2 (brush strip on both sides of each guide) -->
  <record id="bl_rs_brush_guide" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_brush_guide"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
box_mm = int(box_size)
guide_m = 2 * (height - box_mm) / 1000
quantity = guide_m * 2 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Gasket XMO 60: (height - 72) / 1000 m -->
  <record id="bl_rs_gasket" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_gasket"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (height - 72) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Terminal 51x8 (bottom bar): same as gasket -->
  <record id="bl_rs_terminal" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_terminal"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (height - 72) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Box Standard 165×165: (width - 10) / 1000 m -->
  <record id="bl_rs_box" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_box_165"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (width - 10) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Axis 40: (width - 55) / 1000 m [manual/chain — coeff=1; motor drives → Axis 60 O-variant] -->
  <record id="bl_rs_axis40" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_axis40"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (width - 55) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Axis 60 [O-variant — activated when motor replaces Axis 40]: (width - 70) / 1000 m -->
  <!-- NOTE: in production, Axis 40 and Axis 60 are mutually exclusive via coeff logic.
       coeff_default=0 here; a separate formula override should set coeff=0 for Axis40 when motor-o fires. -->
  <record id="bl_rs_axis60" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_axis60"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (width - 70) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">motor-o</field>
  </record>

  <!-- Slat AL 40mm: slat_count × (width - 72) / 1000 linear meters -->
  <record id="bl_rs_slat" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_slat_al"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
import math
box_mm = int(box_size)
# slat_height_mm comes from T1 geometry table
slat_count = math.ceil((height - box_mm / 2) / slat_height_mm)
quantity = slat_count * (width - 72) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- End cap 165×165: 1 set -->
  <record id="bl_rs_end_cap" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_end_cap"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
