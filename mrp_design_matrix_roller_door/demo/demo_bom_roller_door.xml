  </record>

  <!-- Cup 60 [O-variant motor] -->
  <record id="bl_rs_cup60" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_cup60"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">motor-o</field>
  </record>

  <!-- Entry Guide 45: 1 set -->
  <record id="bl_rs_entry_guide" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_entry_guide"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Security springs: max(2, floor((height - box_mm) / 500) + 1) -->
  <record id="bl_rs_sec_spring" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_sec_spring"/>
    <field name="product_qty">2.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
import math
box_mm = int(box_size)
quantity = max(2, math.floor((height - box_mm) / 500) + 1) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Rivet 3×8: 10 per box -->
  <record id="bl_rs_rivet_3x8" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_rivet_3x8"/>
    <field name="product_qty">10.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Rivet 4×10: 10 per box -->
  <record id="bl_rs_rivet_4x10" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_rivet_4x10"/>
    <field name="product_qty">10.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Taps WT-900: min 6, approx 3 per AL guide + 1 per 500mm height -->
  <record id="bl_rs_tap" model="mrp.bom.line">
    <field name="bom_id" ref="bom_roller_shutter_standard"/>
    <field name="product_id" ref="product_tmpl_rs_tap"/>
    <field name="product_qty">6.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
import math
box_mm = int(box_size)
guide_m = 2 * (height - box_mm) / 1000
quantity = max(6, math.ceil(guide_m / 0.5)) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
