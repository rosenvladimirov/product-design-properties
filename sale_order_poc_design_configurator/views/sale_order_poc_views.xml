     Цената, която матрицата смята за офертата (ADR sale-order-poc/0019):
     до количеството, за да се чете като „толкова за брой при това количество“.
-->
<odoo>
    <record id="sale_order_poc_view_form_design_matrix" model="ir.ui.view">
        <field name="name">sale.order.poc.form.design.matrix</field>
        <field name="model">sale.order.poc</field>
        <field name="inherit_id" ref="sale_order_poc.sale_order_poc_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_row')][field[@name='product_uom_qty']]" position="after">
                <field name="matrix_cost_unit"
                       invisible="not matrix_cost_unit"/>
                <field name="matrix_price_unit"
                       invisible="not matrix_price_unit and not matrix_price_note"/>
                <field name="matrix_price_note" class="text-warning"
                       invisible="not matrix_price_note"/>
            </xpath>
        </field>
    </record>
</odoo>
