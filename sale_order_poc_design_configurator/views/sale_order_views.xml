<odoo>
    <record id="view_order_form_poc_design_icons" model="ir.ui.view">
        <field name="name">sale.order.form.poc.design.icons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//button[@name='action_open_poc']"
                   position="attributes">
                <attribute name="invisible">(not poc_template_id and not poc_id) or (parent.state not in ('draft', 'sent') and poc_id)</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//widget[@name='design_configurator_open']"
                   position="attributes">
                <attribute name="invisible">not has_design_definition or (poc_template_id and parent.state in ('draft', 'sent'))</attribute>
            </xpath>
        </field>
    </record>
</odoo>
