<odoo>
    <record id="sale_order_poc_view_form_mrp" model="ir.ui.view">
        <field name="name">sale.order.poc.form.mrp</field>
        <field name="model">sale.order.poc</field>
        <field name="inherit_id" ref="sale_order_poc.sale_order_poc_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_productions" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="not production_count">
                    <field name="production_count" widget="statinfo" string="Manufacturing"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="sale_order_poc_template_view_form_mrp" model="ir.ui.view">
        <field name="name">sale.order.poc.template.form.mrp</field>
        <field name="model">sale.order.poc.template</field>
        <field name="inherit_id" ref="sale_order_poc.sale_order_poc_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="lot_batches"/>
                <field name="restrict_component_lots"/>
            </xpath>
        </field>
    </record>
</odoo>
