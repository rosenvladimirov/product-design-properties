<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Тъч редакторът на конфигурацията (POC) в десния екран -->
    <t t-name="sale_order_poc_pos.PocEditor">
        <div t-if="visible" class="o_l10n_bg_poc_editor top-0 start-0 w-100 h-100 d-flex flex-column bg-view"
             t-att-class="props.fullscreen ? 'position-fixed' : 'position-absolute'"
             t-attf-style="z-index: {{ props.fullscreen ? 1050 : 5 }};">
            <div class="d-flex align-items-center gap-2 p-2 border-bottom">
                <i class="fa fa-sliders fa-lg"/>
                <span class="fw-bold text-truncate fs-5 o_l10n_bg_poc_title" t-esc="title"/>
                <span t-if="state.data" class="badge text-bg-info" t-esc="state.data.state_label"/>
                <button class="btn btn-lg btn-secondary ms-auto o_l10n_bg_poc_close" t-on-click="close">
                    <i class="fa fa-times me-1"/>Close
                </button>
            </div>
            <div t-if="!state.data" class="flex-grow-1 d-flex align-items-center justify-content-center text-muted">
                <i class="fa fa-spinner fa-spin fa-2x me-2"/>Loading the configuration…
            </div>
            <div t-else="" class="flex-grow-1 overflow-auto p-2 o_l10n_bg_poc_body">
                <t t-foreach="cards" t-as="card" t-key="card.key">
                    <!-- група полета извън параметрите — своя карта -->
                    <section t-if="card.group" class="o_l10n_bg_poc_card o_l10n_bg_poc_group" t-att-data-group="card.group.key">
                        <div class="o_l10n_bg_poc_head">
                            <span class="o_l10n_bg_poc_number" t-esc="card.number"/>
                            <span class="o_l10n_bg_poc_head_title" t-esc="card.group.title"/>
                        </div>
                        <t t-call="sale_order_poc_pos.PocFieldGroup"><t t-set="group" t-value="card.group"/></t>
                    </section>
                    <section t-else="" class="o_l10n_bg_poc_card" t-att-data-section="card.section.title"
                             t-att-class="{'o_l10n_bg_poc_off': !isSwitchedOn(card.section)}">
                        <t t-set="section" t-value="card.section"/>
                        <div class="o_l10n_bg_poc_head">
                            <span class="o_l10n_bg_poc_number" t-esc="card.number"/>
                            <!-- превключвателят на секцията („С печат“) — в заглавието ѝ, като в
                                 макета; изключен — само заглавието, данните се губят при запис -->
                            <button t-if="section.switch" class="o_l10n_bg_poc_switch"
                                    t-att-data-code="section.switch.code"
                                    t-att-title="section.switch.label"
                                    t-att-disabled="!state.data.editable"
                                    t-on-click="() => this.toggleSwitch(section)">
                                <i t-attf-class="fa {{ isSwitchedOn(section) ? 'fa-check-square' : 'fa-square-o' }}"/>
                            </button>
                            <button class="o_l10n_bg_poc_section o_l10n_bg_poc_head_title"
                                    t-on-click="() => this.toggleSection(section, card.index)">
                                <t t-esc="section.title"/>
                            </button>
                            <i t-if="isSwitchedOn(section)"
                               t-attf-class="fa ms-auto text-muted {{ isSectionOpen(section, card.index) ? 'fa-chevron-up' : 'fa-chevron-down' }}"
                               t-on-click="() => this.toggleSection(section, card.index)"/>
                        </div>
                        <div t-if="isSwitchedOn(section) and isSectionOpen(section, card.index)" class="d-flex gap-4">
                            <div t-attf-class="row g-3 align-content-start {{ section.stacked and state.data.picture ? 'o_l10n_bg_poc_stack' : 'flex-grow-1' }}">
                                <t t-foreach="section.params" t-as="param" t-key="param.code">
                                    <t t-call="sale_order_poc_pos.PocParam"/>
                                    <div t-foreach="anchoredGroups(param.code)" t-as="group" t-key="group.key"
                                         class="col-12 o_l10n_bg_poc_group" t-att-data-group="group.key">
                                        <div class="o_l10n_bg_poc_label mb-1" t-esc="group.title"/>
                                        <t t-call="sale_order_poc_pos.PocFieldGroup"/>
                                    </div>
                                </t>
                            </div>
                            <!-- картинката на вида изделие — вдясно в първата карта -->
                            <div t-if="card.number === 1 and state.data.picture"
                                 t-attf-class="o_l10n_bg_poc_picture {{ section.stacked ? 'o_l10n_bg_poc_picture_wide' : 'flex-shrink-0' }}">
                                <div class="o_l10n_bg_poc_label mb-1">Preview</div>
                                <div class="o_l10n_bg_poc_picture_box">
                                    <img t-if="state.data.picture.url" t-att-src="state.data.picture.url" alt=""/>
                                    <div t-else="" t-out="pictureMarkup"/>
                                </div>
                                <div t-if="state.data.picture.caption" class="o_l10n_bg_poc_label mt-1" t-esc="state.data.picture.caption"/>
                            </div>
                        </div>
                    </section>
                </t>
                <section t-if="state.data.optional" class="o_l10n_bg_poc_card o_l10n_bg_poc_optional">
                    <div class="o_l10n_bg_poc_head">
                        <span class="o_l10n_bg_poc_head_title">Optional Products</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="state.data.optional.options" t-as="option" t-key="option.id">
                            <button class="o_l10n_bg_poc_chip o_l10n_bg_poc_optional_option"
                                    t-att-class="{'active': optionalValue.includes(option.id)}"
                                    t-att-data-id="option.id"
                                    t-att-disabled="!state.data.editable"
                                    t-on-click="() => this.toggleOptional(option.id)">
                                <i t-attf-class="fa {{ optionalValue.includes(option.id) ? 'fa-check-square' : 'fa-square-o' }}"/>
                                <t t-esc="option.name"/>
                            </button>
                        </t>
                    </div>
                </section>
                <!-- готовите продукти близо до размера (ADR sale-order-poc/0027) -->
                <section t-if="state.data.standard" class="o_l10n_bg_poc_card o_l10n_bg_poc_standard">
                    <div class="o_l10n_bg_poc_head">
                        <span class="o_l10n_bg_poc_head_title">Standard Products</span>
                        <button t-if="standardValue" class="btn btn-outline-secondary ms-auto o_l10n_bg_poc_standard_back"
                                t-att-title="state.data.standard.configured"
                                t-att-disabled="state.loading or !state.data.editable"
                                t-on-click="() => this.chooseStandard(false)">
                            <i class="fa fa-undo me-1"/>Back to the configuration
                        </button>
                    </div>
                    <div t-if="standardValue" class="alert alert-info py-2 mb-2">
                        The line sells the standard product; the configuration is kept as the record of the request.
                    </div>
                    <div t-if="!state.data.standard.options.length" class="o_l10n_bg_poc_label">
                        No standard product within the tolerance of this size.
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="state.data.standard.options" t-as="option" t-key="option.id">
                            <button class="o_l10n_bg_poc_chip o_l10n_bg_poc_standard_option text-start"
                                    t-att-class="{'active': standardValue === option.id}"
                                    t-att-data-id="option.id"
                                    t-att-disabled="state.loading or !state.data.editable"
                                    t-on-click="() => this.chooseStandard(option.id)">
                                <i t-attf-class="fa {{ standardValue === option.id ? 'fa-dot-circle-o' : 'fa-circle-o' }}"/>
                                <span class="d-flex flex-column lh-sm">
                                    <span class="fw-bold" t-esc="option.name"/>
                                    <span class="o_l10n_bg_poc_label">
                                        <t t-if="option.size" t-esc="option.size + ' mm · '"/>
                                        <t t-esc="formatCurrency(option.price)"/>
                                        <t t-if="option.qty_available !== null">
                                            <t t-esc="' · ' + option.qty_available + ' '"/><span>on hand</span>
                                        </t>
                                    </span>
                                </span>
                            </button>
                        </t>
                    </div>
                </section>
                <!-- справките на вертикала — смятат се при натискане -->
                <section t-foreach="state.data.reports or []" t-as="report" t-key="report.key"
                         class="o_l10n_bg_poc_card o_l10n_bg_poc_report" t-att-data-report="report.key">
                    <t t-set="loaded" t-value="state.reports[report.key] or {}"/>
                    <div class="o_l10n_bg_poc_head">
                        <span class="o_l10n_bg_poc_head_title" t-esc="report.title"/>
                        <button class="btn btn-outline-secondary ms-auto o_l10n_bg_poc_report_load"
                                t-att-disabled="loaded.loading or dirty" t-on-click="() => this.loadReport(report)">
                            <i t-attf-class="fa {{ loaded.loading ? 'fa-spinner fa-spin' : 'fa-refresh' }} me-1"/>
                            <t t-esc="report.button"/>
                        </button>
                    </div>
                    <div t-if="dirty" class="o_l10n_bg_poc_label">Save and compute first.</div>
                    <t t-if="loaded.result">
                        <t t-foreach="loaded.result.groups" t-as="group" t-key="group_index">
                            <div class="fw-bold mt-2 mb-1" t-esc="group.title"/>
                            <table class="table table-sm o_l10n_bg_poc_table">
                                <thead><tr>
                                    <th t-foreach="loaded.result.columns" t-as="column" t-key="column_index"
                                        t-att-class="column.numeric ? 'text-end' : ''" t-esc="column.label"/>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="group.rows" t-as="row" t-key="row_index">
                                        <td t-foreach="row.cells" t-as="cell" t-key="cell_index"
                                            t-att-class="(loaded.result.columns[cell_index].numeric ? 'text-end ' : '') + ((row.strong or []).includes(cell_index) ? 'o_l10n_bg_poc_strong' : '')"
                                            t-esc="cell"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <div t-foreach="loaded.result.notes or []" t-as="note" t-key="note_index"
                             class="o_l10n_bg_poc_label" t-esc="note"/>
                    </t>
                </section>
                <section t-foreach="state.data.tables" t-as="table" t-key="table.code" class="o_l10n_bg_poc_card">
                    <div class="o_l10n_bg_poc_head"><span class="o_l10n_bg_poc_head_title" t-esc="table.code"/></div>
                    <table class="table table-sm mb-0 o_l10n_bg_poc_table">
                        <tr t-foreach="table.rows" t-as="row" t-key="row_index">
                            <td t-esc="row.key"/><td t-esc="row.product"/>
                            <td class="text-end"><t t-esc="row.value"/> <t t-esc="row.uom"/></td>
                        </tr>
                    </table>
                </section>
            </div>
            <div t-if="state.data" class="d-flex align-items-center gap-3 p-2 border-top">
                <div t-if="state.data.price_base" class="o_l10n_bg_poc_price_base">
                    <div class="text-muted small" t-esc="state.data.price_base.label"/>
                    <div class="btn-group">
                        <t t-foreach="state.data.price_base.options" t-as="option" t-key="option.key">
                            <button class="btn" t-att-data-key="option.key"
                                    t-att-class="priceBase === option.key ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-att-disabled="!state.data.editable"
                                    t-on-click="() => this.setPriceBase(option.key)" t-esc="option.label"/>
                        </t>
                    </div>
                </div>
                <div class="lh-sm">
                    <div class="text-muted small" t-esc="state.data.summary"/>
                    <div t-if="state.data.price_note" class="text-danger small o_l10n_bg_poc_price_note" t-esc="state.data.price_note"/>
                    <div>Unit price: <span class="fw-bold o_l10n_bg_poc_price" t-esc="formatCurrency(state.data.line.price_unit)"/>
                        · Subtotal: <span class="fw-bold" t-esc="formatCurrency(state.data.line.price_subtotal)"/></div>
                </div>
                <button class="btn btn-lg btn-primary ms-auto o_l10n_bg_poc_compute"
                        t-att-disabled="state.loading or !state.data.editable" t-on-click="compute">
                    <i t-attf-class="fa {{ state.loading ? 'fa-spinner fa-spin' : 'fa-calculator' }} me-1"/>
                    <t t-if="dirty">Save and compute</t><t t-else="">Compute</t>
                </button>
            </div>
        </div>
    </t>

    <!-- един параметър от секция: числата по три на ред, изборите — плочки с
         радио, отметките — плочки с отметка (макет „Изделие по поръчка“) -->
    <t t-name="sale_order_poc_pos.PocParam">
        <!-- секция „stacked“ (до голямата визуализация): полетата едно под друго -->
        <div t-attf-class="{{ section.stacked ? (param.type === 'boolean' ? 'col-12 col-xl-6' : 'col-12') : param.type === 'boolean' ? 'col-6 col-xl-3' : ['selection', 'tags', 'many2many', 'text', 'many2one'].includes(param.type) ? 'col-12' : 'col-6 col-lg-4' }} o_l10n_bg_poc_param" t-att-data-code="param.code">
            <div t-if="param.type !== 'boolean'" class="o_l10n_bg_poc_label mb-1">
                <t t-esc="param.label"/>
                <span t-if="param.suffix and (param.type === 'float' or param.type === 'integer')" class="ms-1">(<t t-esc="param.suffix"/>)</span>
                <span t-if="param.origin === 'formula'" class="badge text-bg-light ms-1" title="Computed by a formula">ƒ</span>
                <span t-if="param.code in state.updates" class="badge text-bg-warning ms-1">changed</span>
            </div>
            <t t-set="val" t-value="value(param)"/>
            <input t-if="param.type === 'float' or param.type === 'integer'" type="number"
                   class="form-control" t-att-step="param.type === 'integer' ? 1 : 'any'"
                   t-att-value="val === null or val === undefined or val === false ? '' : val"
                   t-att-disabled="!state.data.editable or param.readonly"
                   t-on-input="(ev) => this.onNumber(param, ev)"/>
            <button t-elif="param.type === 'boolean'" class="o_l10n_bg_poc_chip w-100 o_l10n_bg_poc_toggle"
                    t-att-class="{'active': val}"
                    t-att-disabled="!state.data.editable or param.readonly" t-on-click="() => this.set(param, !val)">
                <i t-attf-class="fa {{ val ? 'fa-check-square' : 'fa-square-o' }}"/>
                <span t-esc="param.label"/>
                <span t-if="param.origin === 'formula'" class="ms-1" title="Computed by a formula">ƒ</span>
            </button>
            <div t-elif="param.type === 'selection' and param.options.length &lt;= 8 and !section.stacked and !param.readonly" class="d-flex flex-wrap gap-2">
                <t t-foreach="param.options" t-as="option" t-key="option.key">
                    <button class="o_l10n_bg_poc_chip o_l10n_bg_poc_option" t-att-class="{'active': val === option.key}"
                            t-att-data-key="option.key"
                            t-att-disabled="!state.data.editable or param.readonly" t-on-click="() => this.set(param, option.key)">
                        <i t-attf-class="fa {{ val === option.key ? 'fa-dot-circle-o' : 'fa-circle-o' }}"/>
                        <t t-esc="option.label"/>
                    </button>
                </t>
            </div>
            <div t-elif="param.type === 'selection' and param.readonly" class="form-control o_l10n_bg_poc_readonly d-flex align-items-center"
                 t-esc="(param.options.find((option) => option.key === val) or {}).label or '—'"/>
            <select t-elif="param.type === 'selection'" class="form-select"
                    t-att-disabled="!state.data.editable or param.readonly" t-on-change="(ev) => this.set(param, ev.target.value || false)">
                <option value=""/>
                <t t-foreach="param.options" t-as="option" t-key="option.key">
                    <option t-att-value="option.key" t-att-selected="val === option.key" t-esc="option.label"/>
                </t>
            </select>
            <div t-elif="param.type === 'tags'" class="d-flex flex-wrap gap-2">
                <t t-foreach="param.options" t-as="option" t-key="option.key">
                    <button class="o_l10n_bg_poc_chip" t-att-class="{'active': (val or []).includes(option.key)}"
                            t-att-disabled="!state.data.editable or param.readonly" t-on-click="() => this.toggleTag(param, option.key)">
                        <i t-attf-class="fa {{ (val or []).includes(option.key) ? 'fa-check-square' : 'fa-square-o' }}"/>
                        <t t-esc="option.label"/>
                    </button>
                </t>
            </div>
            <select t-elif="param.type === 'many2one'" class="form-select o_l10n_bg_poc_half"
                    t-att-disabled="!state.data.editable or param.readonly" t-on-change="(ev) => this.onRecord(param, ev)">
                <option value=""/>
                <t t-foreach="param.options" t-as="option" t-key="option.id">
                    <option t-att-value="option.id" t-att-selected="val === option.id" t-esc="option.name"/>
                </t>
            </select>
            <div t-elif="param.type === 'many2many'" class="d-flex flex-wrap gap-2">
                <t t-foreach="param.options" t-as="option" t-key="option.id">
                    <button class="o_l10n_bg_poc_chip" t-att-class="{'active': (val or []).includes(option.id)}"
                            t-att-disabled="!state.data.editable or param.readonly" t-on-click="() => this.toggleTag(param, option.id)">
                        <i t-attf-class="fa {{ (val or []).includes(option.id) ? 'fa-check-square' : 'fa-square-o' }}"/>
                        <t t-esc="option.name"/>
                    </button>
                </t>
            </div>
            <input t-elif="param.type === 'date'" type="date" class="form-control"
                   t-att-value="val or ''" t-att-disabled="!state.data.editable or param.readonly"
                   t-on-change="(ev) => this.onText(param, ev)"/>
            <textarea t-elif="param.type === 'text'" rows="2" class="form-control"
                      t-att-value="val or ''" t-att-disabled="!state.data.editable or param.readonly"
                      t-on-input="(ev) => this.onText(param, ev)"/>
            <input t-else="" type="text" class="form-control"
                   t-att-value="val or ''" t-att-disabled="!state.data.editable or param.readonly"
                   t-on-input="(ev) => this.onText(param, ev)"/>
        </div>
    </t>

    <!-- групата полета: числата — в ред с етикет отгоре, отметките — плочки -->
    <t t-name="sale_order_poc_pos.PocFieldGroup">
        <div class="d-flex flex-wrap gap-2">
            <t t-foreach="group.fields" t-as="field" t-key="field.name">
                <button t-if="field.type === 'boolean'" class="o_l10n_bg_poc_chip o_l10n_bg_poc_field_toggle"
                        t-att-data-name="field.name"
                        t-att-class="{'active': fieldValue(field)}"
                        t-att-disabled="!state.data.editable"
                        t-on-click="() => this.setField(field, !this.fieldValue(field))">
                    <i t-attf-class="fa {{ fieldValue(field) ? 'fa-check-square' : 'fa-square-o' }}"/>
                    <t t-esc="field.label"/>
                </button>
                <div t-else="" class="o_l10n_bg_poc_field_number">
                    <div class="o_l10n_bg_poc_label mb-1" t-esc="field.label"/>
                    <input type="number" class="form-control"
                           t-att-data-name="field.name" placeholder="—"
                           t-att-step="field.type === 'integer' ? 1 : 'any'" min="0"
                           t-att-value="fieldValue(field) || ''"
                           t-att-disabled="!state.data.editable"
                           t-on-input="(ev) => this.onFieldNumber(field, ev)"/>
                </div>
            </t>
        </div>
    </t>

    <t t-name="sale_order_poc_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <!-- голям екран: в десния екран, над продуктите -->
        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="inside">
            <L10nBgPocEditor t-if="currentOrder?.l10n_bg_wholesale and !pos.isSmallProductScreen"/>
        </xpath>
        <!-- малък екран (таблет/телефон): редовете и продуктите не се виждат
             едновременно — редакторът е на целия екран -->
        <xpath expr="//div[hasclass('product-screen')]" position="inside">
            <L10nBgPocEditor t-if="currentOrder?.l10n_bg_wholesale and pos.isSmallProductScreen" fullscreen="true"/>
        </xpath>
    </t>
</templates>
