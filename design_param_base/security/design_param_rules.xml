<odoo noupdate="1">

    <!-- Multi-company rule: a definition is visible when its
         ``company_ids`` is empty (global) OR intersects with the
         user's currently allowed companies from ``allowed_company_ids``
         (set by the Odoo company switcher, falls back to
         ``user.company_ids`` when absent). -->
    <record id="design_param_definition_multi_company_rule" model="ir.rule">
        <field name="name">Design Parameter Definition multi-company</field>
        <field name="model_id" ref="model_design_param_definition"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('company_ids', '=', False),
            ('company_ids', 'in', user.company_ids.ids),
        ]</field>
    </record>

</odoo>
