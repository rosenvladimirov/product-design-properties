<!--
    Canonical design industries (full-normalization vocabulary).
    Mixed-axis free-text tags are folded here via INDUSTRY_ALIASES:
        bags / corrugated      → packaging
        roller_garage_door     → doors
        doors / food / electronics / base → themselves
    Unknown tags are auto-created on resolution (design.industry._resolve).
-->
<odoo noupdate="1">

  <record id="industry_base" model="design.industry">
    <field name="sequence">1</field>
    <field name="code">base</field>
    <field name="name">Base</field>
    <field name="description">Shared base parameter sets (not a product industry).</field>
  </record>

  <record id="industry_doors" model="design.industry">
    <field name="sequence">10</field>
    <field name="code">doors</field>
    <field name="name">Doors &amp; Shutters</field>
    <field name="description">Roller shutters, garage doors, interior and security doors.</field>
  </record>

  <record id="industry_packaging" model="design.industry">
    <field name="sequence">20</field>
    <field name="code">packaging</field>
    <field name="name">Packaging</field>
    <field name="description">Plastic bags and corrugated cartons.</field>
  </record>

  <record id="industry_food" model="design.industry">
    <field name="sequence">30</field>
    <field name="code">food</field>
    <field name="name">Food</field>
    <field name="description">Canned and processed food products.</field>
  </record>

  <record id="industry_electronics" model="design.industry">
    <field name="sequence">40</field>
    <field name="code">electronics</field>
    <field name="name">Electronics</field>
    <field name="description">Smart displays and electronic assemblies.</field>
  </record>

</odoo>
