<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        OVERRIDE of sale_design_configurator.DesignConfiguratorWidget template.
        Module load order: this XML loads AFTER upstream, so this definition wins.

        Layout mirrors prototype/web_configurator_mockup.html (Vladimir's spec
        frozen 2026-05-12).  Stage 1+2 = base layout + per-shutter dimension
        rows.  Stage 3+4 = color/motor sub-modals (next iteration).
    -->
    <t t-name="teolino_sale_design_configurator_ui.DesignConfiguratorWidget">
        <div class="o_teolino_cfg">

            <t t-set="byStr" t-value="teolinoParamsByString"/>

            <!-- Вид на щората -->
            <t t-if="byStr['shutter_model']">
                <div class="o_teo_row">
                    <div class="o_teo_label">Вид на щората</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['shutter_model'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['shutter_model'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['shutter_model'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Управление -->
            <t t-if="byStr['control_type']">
                <div class="o_teo_row">
                    <div class="o_teo_label">Управление</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['control_type'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['control_type'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['control_type'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Цвят на щората (main) -->
            <t t-if="byStr['main_color']">
                <div class="o_teo_row">
                    <div class="o_teo_label">Цвят на щората</div>
                    <select class="o_teo_select"
                            t-att-data-param="byStr['main_color'].name"
                            t-on-change="onTextChange">
                        <option value="">— избери —</option>
                        <t t-foreach="byStr['main_color'].selection" t-as="opt" t-key="opt[0]">
                            <option t-att-value="opt[0]"
                                    t-att-selected="params[byStr['main_color'].name] === opt[0] ? 'selected' : null">
                                <t t-esc="opt[1]"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="o_teo_row">
                    <button class="o_teo_btn_ghost"
                            t-on-click="teolinoOpenColorModal">
                        Цветове на компонентите ▸
                    </button>
                </div>
            </t>

            <!-- Брой щори -->
            <t t-if="byStr['shutter_count']">
                <div class="o_teo_row">
                    <div class="o_teo_label">Брой щори в една кутия</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['shutter_count'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['shutter_count'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['shutter_count'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Размери (per-shutter; Stage 2) -->
            <div class="o_teo_row">
                <div class="o_teo_label">
                    Размери (mm)
                    <span class="o_teo_aux">макс L=4000, H=3500 на щора</span>
                </div>
                <div class="o_teo_dim_block">
                    <t t-set="sc" t-value="teolinoShutterCount()"/>
                    <t t-if="sc &lt;= 1">
                        <t t-set="widthParam" t-value="byStr['Width (mm)']"/>
                        <t t-set="heightParam" t-value="byStr['Height (mm)']"/>
                        <div class="o_teo_dim_row">
                            <label>L (mm)</label>
                            <input type="number" min="300" max="4000" step="1"
                                   t-att-value="widthParam and params[widthParam.name]"
                                   t-att-data-param="widthParam and widthParam.name"
                                   t-on-change="teolinoOnDimChange"/>
                            <label>H (mm)</label>
                            <input type="number" min="300" max="3500" step="1"
                                   t-att-value="heightParam and params[heightParam.name]"
                                   t-att-data-param="heightParam and heightParam.name"
                                   t-on-change="teolinoOnDimChange"/>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="teolinoShutterIndices()" t-as="i" t-key="i">
                            <div class="o_teo_dim_row">
                                <label>Щ.<t t-esc="i + 1"/></label>
                                <span>L</span>
                                <input type="number" min="300" max="4000" step="1"
                                       t-att-value="teolinoPerShutterL(i)"
                                       t-att-data-shutter-index="i"
                                       t-att-data-dim="'L'"
                                       t-on-change="teolinoOnPerShutterDimChange"/>
                                <span>H</span>
                                <input type="number" min="300" max="3500" step="1"
                                       t-att-value="teolinoPerShutterH(i)"
                                       t-att-data-shutter-index="i"
                                       t-att-data-dim="'H'"
                                       t-on-change="teolinoOnPerShutterDimChange"/>
                            </div>
                        </t>
                        <div class="o_teo_dim_total">
                            Общо L = <strong><t t-esc="teolinoTotalL()"/></strong> mm
                        </div>
                    </t>
                </div>
            </div>

            <!-- Ламел -->
            <t t-if="byStr['slat_size']">
                <div class="o_teo_row">
                    <div class="o_teo_label">Ламел</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['slat_size'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['slat_size'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['slat_size'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Ос -->
            <t t-if="byStr['axis_size']">
                <div class="o_teo_row">
                    <div class="o_teo_label">Ос</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['axis_size'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['axis_size'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['axis_size'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Кутия -->
            <t t-if="byStr['box_size'] and teolinoBoxAllowed()">
                <div class="o_teo_row">
                    <div class="o_teo_label">Кутия</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['box_size'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['box_size'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['box_size'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Водач (visible само за Thermo Comfort) -->
            <t t-if="byStr['guide_type'] and teolinoGuideVisible()">
                <div class="o_teo_row">
                    <div class="o_teo_label">Водач</div>
                    <div class="o_teo_seg">
                        <t t-foreach="teolinoFiltered(byStr['guide_type'])" t-as="opt" t-key="opt[0]">
                            <button
                                t-att-class="'o_teo_btn' + (params[byStr['guide_type'].name] === opt[0] ? ' active' : '')"
                                t-att-data-param="byStr['guide_type'].name"
                                t-att-data-value="opt[0]"
                                t-on-click="onSegmentClick">
                                <t t-esc="opt[1]"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Debug summary (toggle later) -->
            <div class="o_teo_summary">
                <small>shutter_count=<t t-esc="teolinoShutterCount()"/></small>
            </div>

            <!-- Hard max warning -->
            <t t-if="teolinoHardMaxExceeded()">
                <div class="o_teo_hard_warn">
                    ⚠ Размерите надхвърлят позволените. <t t-esc="teolinoMaxBoxMessage()"/>
                </div>
            </t>

            <!-- Live BoM preview (Sprint 5) -->
            <t t-set="preview" t-value="teolinoBomPreview()"/>
            <div class="o_teo_preview" t-if="!preview.hidden">
                <div class="o_teo_preview_head">
                    <strong>Калкулация на материалите</strong>
                    <t t-if="preview.loading">
                        <span class="o_teo_aux ms-2"><i class="fa fa-spinner fa-spin"/> изчисляване...</span>
                    </t>
                    <t t-elif="preview.error">
                        <span class="o_teo_preview_err">⚠ <t t-esc="preview.error"/></span>
                    </t>
                    <span class="o_teo_preview_total ms-auto">
                        Общо: <strong><t t-esc="teolinoFormatNum(preview.total_material)"/> лв.</strong>
                    </span>
                </div>
                <t t-if="preview.lines and preview.lines.length">
                    <table class="o_teo_preview_table">
                        <thead>
                            <tr>
                                <th>Материал</th>
                                <th class="text-end">Количество</th>
                                <th class="text-end">Ед. цена</th>
                                <th class="text-end">Сума</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="teolinoBomPreviewActiveLines()" t-as="ln" t-key="ln.bom_line_id">
                                <tr>
                                    <td><t t-esc="ln.product_name"/></td>
                                    <td class="text-end"><t t-esc="teolinoFormatNum(ln.qty, 3)"/> <small><t t-esc="ln.uom"/></small></td>
                                    <td class="text-end"><t t-esc="teolinoFormatNum(ln.unit_cost)"/></td>
                                    <td class="text-end"><t t-esc="teolinoFormatNum(ln.subtotal)"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="o_teo_aux">
                        Активни редове: <t t-esc="preview.active_count"/> от <t t-esc="preview.total_count"/>
                    </div>
                </t>
            </div>

            <!-- Footer buttons (matches upstream o_cfg_footer behavior) -->
            <div class="o_teo_footer">
                <button class="btn btn-primary"
                        t-att-disabled="hasErrors or ui.saving or teolinoHardMaxExceeded()"
                        t-on-click="onConfirm">
                    <t t-if="ui.saving">
                        <i class="fa fa-spinner fa-spin"/> Saving...
                    </t>
                    <t t-else="">
                        <t t-if="props.existingLotId">Update Lot</t>
                        <t t-else="">Create Design Lot</t>
                    </t>
                </button>
                <button class="btn btn-secondary ms-2" t-on-click="props.onClose">Cancel</button>
            </div>

            <!-- Hidden Three.js canvas placeholder.  Upstream's onMounted calls
                 _initThree() which needs canvasRef.el to exist; we keep the
                 element invisible until Stage 5 (3D preview).  Overlay ref is
                 also touched by upstream code. -->
            <div class="o_teo_hidden_canvas">
                <canvas t-ref="canvas" width="320" height="240"/>
                <div t-ref="overlay"/>
            </div>

        </div>
    </t>

</templates>
