<odoo>

    <record id="mrp_routing_workcenter_form_view_formula" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.operation.formula</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Operation Formula" name="operation_formula">
                    <field name="formula_template_id"
                           options="{'no_quick_create': True}"/>
                    <field name="operation_formula"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
