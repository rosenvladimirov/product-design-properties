<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_design_markups" model="ir.ui.view">
        <field name="name">product.template.form.design.markups</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/group" position="inside">
                <group string="Design Pricing" name="design_pricing"
                       invisible="not design_param_definition_id">
                    <field name="design_material_markup_percent"
                           help="Override category/company default. Leave 0 to inherit."/>
                    <field name="design_labor_markup_percent"
                           help="Override category/company default. Leave 0 to inherit."/>
                    <field name="effective_material_markup_percent" readonly="1"/>
                    <field name="effective_labor_markup_percent" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
