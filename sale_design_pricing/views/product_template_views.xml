<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_design_markups" model="ir.ui.view">
        <field name="name">product.template.form.design.markups</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Собствен таб (по-видимо от вгнездена група в General Information). -->
            <xpath expr="//notebook" position="inside">
                <page string="Design Pricing" name="design_pricing"
                      invisible="not design_param_definition_id" groups="base.group_system">
                    <group>
                        <group string="Надценки (override; 0 = наследи)">
                            <field name="design_material_markup_percent"/>
                            <field name="design_labor_markup_percent"/>
                        </group>
                        <group string="Реално важащи (effective)">
                            <field name="effective_material_markup_percent" readonly="1"/>
                            <field name="effective_labor_markup_percent" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
