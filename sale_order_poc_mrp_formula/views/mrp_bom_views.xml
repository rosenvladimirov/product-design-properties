<odoo>
    <record id="mrp_bom_form_view_poc_formula" model="ir.ui.view">
        <field name="name">mrp.bom.form.poc.formula</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_check_poc_formulas" type="object"
                            string="Check Configuration Formulas"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
