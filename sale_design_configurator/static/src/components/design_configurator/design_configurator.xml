<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="sale_design_configurator.DesignConfiguratorWidget">
    <div class="o_design_configurator">

        <!-- Left panel: parameters -->
        <div class="o_cfg_panel">

            <div class="o_cfg_params">
                <t t-foreach="displayParams" t-as="param" t-key="param.name">

                    <!-- Float: Width/Height/Thickness → slider, Wall Width → spinner, rest → slider -->
                    <t t-if="param.type === 'float' and param.string and (param.string.includes('Wall') or param.string.includes('Каса'))">
                        <div class="o_cfg_spinner_row">
                            <span class="o_cfg_spinner_label"><t t-esc="param.string"/></span>
                            <input
                                type="number"
                                class="o_input o_cfg_spinner"
                                t-att-min="param.min || 0"
                                t-att-max="param.max || 9999"
                                step="1"
                                t-att-value="param.value"
                                t-att-data-param="param.name"
                                t-on-input="onSliderInput"
                            />
                        </div>
                    </t>

                    <t t-if="param.type === 'float' and (!param.string or !(param.string.includes('Wall') or param.string.includes('Каса')))">
                        <div class="o_cfg_param_row">
                            <div class="o_cfg_param_label">
                                <span><t t-esc="param.string"/></span>
                                <strong><t t-esc="param.value"/></strong>
                            </div>
                            <input
                                type="range"
                                t-att-min="param.min || 0"
                                t-att-max="param.max || 9999"
                                t-att-step="param.step || 1"
                                t-att-value="param.value"
                                t-att-data-param="param.name"
                                t-on-input="onSliderInput"
                            />
                        </div>
                    </t>

                    <!-- Selection: segmented buttons -->
                    <t t-if="param.type === 'selection' and param.selection">
                        <div class="o_cfg_param_row">
                            <div class="o_cfg_param_label">
                                <span><t t-esc="param.string"/></span>
                            </div>
                            <div class="o_cfg_seg">
                                <t t-foreach="param.selection" t-as="opt" t-key="opt[0]">
                                    <button
                                        t-att-class="'o_cfg_seg_btn' + (params[param.name] === opt[0] ? ' active' : '')"
                                        t-att-data-value="opt[0]"
                                        t-att-data-param="param.name"
                                        t-on-click="onSegmentClick"
                                    >
                                        <t t-esc="opt[1]"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Boolean: checkbox -->
                    <t t-if="param.type === 'boolean'">
                        <label class="o_cfg_check">
                            <input
                                type="checkbox"
                                t-att-checked="params[param.name]"
                                t-att-data-param="param.name"
                                t-on-change="onCheckChange"
                            />
                            <span><t t-esc="param.string"/></span>
                        </label>
                    </t>

                    <!-- Char: text input -->
                    <t t-if="param.type === 'char'">
                        <div class="o_cfg_param_row">
                            <div class="o_cfg_param_label">
                                <span><t t-esc="param.string"/></span>
                            </div>
                            <input
                                type="text"
                                class="o_input"
                                t-att-value="params[param.name]"
                                t-att-data-param="param.name"
                                t-on-change="onTextChange"
                                style="width: 100%;"/>
                        </div>
                    </t>

                </t>
            </div>

            <!-- Fine tuning: spinners for dimension params -->
            <div class="o_cfg_finetune">
                <div class="o_cfg_finetune_title">Fine Tuning</div>
                <t t-foreach="displayParams" t-as="param" t-key="'ft_' + param.name">
                    <t t-if="param.type === 'float' and param.string and param.string.includes('mm') and !(param.string.includes('Wall') or param.string.includes('Каса'))">
                        <div class="o_cfg_spinner_row">
                            <span class="o_cfg_spinner_label"><t t-esc="param.string"/></span>
                            <input
                                type="number"
                                class="o_input o_cfg_spinner"
                                t-att-min="param.min || 0"
                                t-att-max="param.max || 9999"
                                step="1"
                                t-att-value="param.value"
                                t-att-data-param="param.name"
                                t-on-input="onSliderInput"
                            />
                        </div>
                    </t>
                </t>
            </div>

            <!-- Child components fine tuning (e.g., door leaf) -->
            <t t-foreach="childDisplayParams" t-as="child" t-key="child.definitionCode">
                <div class="o_cfg_finetune">
                    <div class="o_cfg_finetune_title"><t t-esc="child.definitionName"/></div>
                    <t t-foreach="child.params" t-as="cp" t-key="cp.name">

                        <!-- Selection -->
                        <t t-if="cp.type === 'selection' and cp.selection">
                            <div class="o_cfg_param_row">
                                <div class="o_cfg_param_label">
                                    <span><t t-esc="cp.string"/></span>
                                </div>
                                <div class="o_cfg_seg">
                                    <t t-foreach="cp.selection" t-as="opt" t-key="opt[0]">
                                        <button
                                            t-att-class="'o_cfg_seg_btn' + (params[cp.name] === opt[0] ? ' active' : '')"
                                            t-att-data-value="opt[0]"
                                            t-att-data-param="cp.name"
                                            t-on-click="onSegmentClick">
                                            <t t-esc="opt[1]"/>
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <!-- Float spinner -->
                        <t t-if="cp.type === 'float'">
                            <div class="o_cfg_spinner_row">
                                <span class="o_cfg_spinner_label"><t t-esc="cp.string"/></span>
                                <input type="number" class="o_input o_cfg_spinner"
                                       t-att-min="cp.min || 0" t-att-max="cp.max || 9999"
                                       step="1" t-att-value="cp.value"
                                       t-att-data-param="cp.name"
                                       t-on-input="onSliderInput"/>
                            </div>
                        </t>

                        <!-- Boolean -->
                        <t t-if="cp.type === 'boolean'">
                            <label class="o_cfg_check">
                                <input type="checkbox" t-att-checked="params[cp.name]"
                                       t-att-data-param="cp.name" t-on-change="onCheckChange"/>
                                <span><t t-esc="cp.string"/></span>
                            </label>
                        </t>

                    </t>
                </div>
            </t>

            <!-- Validation messages -->
            <div class="o_cfg_validation" t-if="ui.validErrors.length or ui.validWarns.length">
                <t t-foreach="ui.validErrors" t-as="err" t-key="err">
                    <div class="o_cfg_msg o_cfg_msg_error">
                        <i class="fa fa-times-circle"/> <t t-esc="err"/>
                    </div>
                </t>
                <t t-foreach="ui.validWarns" t-as="warn" t-key="warn">
                    <div class="o_cfg_msg o_cfg_msg_warn">
                        <i class="fa fa-exclamation-triangle"/> <t t-esc="warn"/>
                    </div>
                </t>
            </div>

            <!-- Footer buttons -->
            <div class="o_cfg_footer">
                <button
                    class="btn btn-primary"
                    t-att-disabled="hasErrors or ui.saving"
                    t-on-click="onConfirm">
                    <t t-if="ui.saving">
                        <i class="fa fa-spinner fa-spin"/> Saving...
                    </t>
                    <t t-else="">
                        <t t-if="props.existingLotId">Update Lot</t>
                        <t t-else="">Create Design Lot</t>
                    </t>
                </button>
                <button class="btn btn-secondary ms-2" t-on-click="props.onClose">
                    Cancel
                </button>
            </div>

        </div>

        <!-- Right panel: 3D viewport -->
        <div class="o_cfg_viewport">
            <canvas t-ref="canvas"/>
            <div class="o_cfg_viewport_controls">
                <button class="o_cfg_ctrl_btn" t-on-click="toggleAutoRotate"
                        t-att-title="ui.autoRotate ? 'Pause rotation' : 'Resume rotation'">
                    <i t-att-class="ui.autoRotate ? 'fa fa-pause' : 'fa fa-play'"/>
                </button>
                <button class="o_cfg_ctrl_btn" t-on-click="resetView" title="Reset view">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
            <div class="o_cfg_rotate_hint" t-if="ui.autoRotate">Drag to rotate</div>

            <!-- Accessory overlay panel (bottom sheet) -->
            <div t-ref="overlay" class="o_cfg_overlay"
                 t-att-style="'height:' + ui.overlayHeight + 'px'">
                <div class="o_cfg_overlay_handle" t-on-mousedown="onOverlayHandleDrag">
                    <div class="o_cfg_overlay_grip"/>
                </div>
                <div class="o_cfg_overlay_body">
                    <div class="o_cfg_overlay_desc" t-if="ui.description">
                        <t t-esc="ui.description"/>
                    </div>
                    <t t-foreach="overlayGroups" t-as="group" t-key="group.bomProductId">
                        <div class="o_cfg_overlay_section_title">
                            <t t-esc="group.componentName"/>
                        </div>
                        <div class="o_cfg_overlay_grid">
                            <t t-foreach="group.variants" t-as="v" t-key="v.variant_id">
                                <div t-att-class="'o_cfg_overlay_card' + (v.selected ? ' active' : '')"
                                     t-att-data-param="group.paramKey"
                                     t-att-data-variant="v.variantStr"
                                     t-on-click="onAccessorySelect">
                                    <img t-att-src="v.imageUrl"
                                         class="o_cfg_overlay_card_img"
                                         t-att-alt="v.ptav_name"/>
                                    <div class="o_cfg_overlay_card_name">
                                        <t t-esc="v.ptav_name"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </div>

    </div>
</t>

</templates>
