<templates xml:space="preserve">

<t t-name="sale_design_configurator.DesignConfiguratorDialog">
    <Dialog title="'Design Configurator'" size="'lg'" footer="false">
        <t t-if="state.loading">
            <div class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            </div>
        </t>
        <t t-else="">
            <DesignConfiguratorWidget
                productId="props.productId"
                definitionId="props.definitionId"
                definitionCode="state.definitionCode"
                paramDefinition="state.paramDefinition"
                validationRules="state.validationRules"
                profiles="state.profiles"
                bomAssets="state.bomAssets"
                mainProductAssets="state.mainProductAssets"
                childComponents="state.childComponents"
                accessoryVariants="state.accessoryVariants"
                modelVariants="state.modelVariants"
                constraintTable="state.constraintTable"
                geometryTable="state.geometryTable"
                materialTable="state.materialTable"
                operationTable="state.operationTable"
                bomLines="state.bomLines"
                existingLotId="props.existingLotId or false"
                onLotCreated.bind="onLotCreated"
                onClose.bind="onClose"
            />
        </t>
    </Dialog>
</t>

</templates>
