<templates xml:space="preserve">

    <t t-name="sale_design_configurator.T0InlineMessages">
        <t t-if="state.loading">
            <i class="fa fa-spinner fa-spin text-muted" style="font-size: 11px;"/>
        </t>
        <t t-elif="hasMessages">
            <div class="o_t0_inline_msgs">
                <t t-foreach="state.results" t-as="r" t-key="r_index">
                    <span t-attf-class="o_t0_msg #{r.cssClass}" t-att-title="r.description">
                        <i t-attf-class="fa #{r.icon}"/>
                        <t t-out="r.message"/>
                    </span>
                </t>
            </div>
        </t>
    </t>

</templates>
