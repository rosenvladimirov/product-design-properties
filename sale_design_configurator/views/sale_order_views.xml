<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!--  SO form: extend order_line list to show design configurator        -->
    <!-- ================================================================== -->

    <record id="sale_order_form_design_configurator" model="ir.ui.view">
        <field name="name">sale.order.form.design.configurator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Hidden helper fields (must be in the list to use in invisible) -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
                <field name="has_design_definition" column_invisible="True"/>
                <field name="design_param_definition_id" column_invisible="True"/>
            </xpath>

            <!-- Design columns AFTER price_subtotal (end of the line) -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_subtotal']" position="after">
                <widget name="design_configurator_open"
                        column_invisible="False"
                        invisible="not has_design_definition"
                        width="40px"/>

                <field
                    name="design_lot_id"
                    optional="show"
                    string="Design Lot"
                    invisible="not has_design_definition"/>

                <field
                    name="design_params_summary"
                    optional="hide"
                    string="Design Params"
                    invisible="not design_lot_id"/>

                <widget name="t0_inline_messages"
                        column_invisible="False"
                        invisible="not design_lot_id"
                        width="200px"/>
            </xpath>

        </field>
    </record>

    <!-- ================================================================== -->
    <!--  mrp.production: Configurator button                                -->
    <!-- ================================================================== -->

    <record id="mrp_production_form_configurator_btn" model="ir.ui.view">
        <field name="name">mrp.production.form.design.configurator</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="lot_producing_ids" position="after">
                <button name="action_open_design_configurator"
                        string="Configurator"
                        type="object"
                        class="btn-secondary btn-sm"
                        icon="fa-cube"
                        invisible="not bom_id"/>
            </field>
        </field>
    </record>

</odoo>
