<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- product.product form: Preview Design Configurator widget -->
    <record id="product_product_form_design_configurator" model="ir.ui.view">
        <field name="name">product.product.form.design.configurator</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_design_assets.product_product_form_design_assets"/>
        <field name="arch" type="xml">
            <field name="design_param_definition_id" position="after">
                <widget name="design_configurator_open"
                        invisible="not design_param_definition_id"/>
            </field>
        </field>
    </record>

    <!-- product.template form: Preview Design Configurator widget -->
    <record id="product_template_form_design_configurator" model="ir.ui.view">
        <field name="name">product.template.form.design.configurator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_design_assets.product_template_form_design_assets"/>
        <field name="arch" type="xml">
            <field name="design_param_definition_id" position="after">
                <widget name="design_configurator_open"
                        invisible="not design_param_definition_id"/>
            </field>
        </field>
    </record>

</odoo>
