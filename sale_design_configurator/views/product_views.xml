<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- product.product form: Preview Configurator smart button -->
    <record id="product_product_form_design_configurator" model="ir.ui.view">
        <field name="name">product.product.form.design.configurator</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <widget name="design_configurator_open"
                        invisible="not design_param_definition_id"/>
            </div>
        </field>
    </record>

    <!-- product.template form: Preview Configurator smart button -->
    <record id="product_template_form_design_configurator" model="ir.ui.view">
        <field name="name">product.template.form.design.configurator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <widget name="design_configurator_open"
                        invisible="not design_param_definition_id"/>
            </div>
        </field>
    </record>

</odoo>
