<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend stock.lot form: add Configure Design button -->
    <record id="stock_lot_form_design_configurator" model="ir.ui.view">
        <field name="name">stock.lot.form.design.configurator</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="design_param_definition_id" position="after">
                <widget name="design_configurator_open"
                        invisible="not design_param_definition_id"/>
            </field>
        </field>
    </record>

</odoo>
