<odoo>
    <record id="res_config_settings_view_form_design" model="ir.ui.view">
        <field name="name">res.config.settings.form.design</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Design Configurator" name="design_configurator_settings">
                    <setting string="Active Design Definitions"
                             help="Select which design parameter definitions are available for this company. Leave empty to allow all.">
                        <field name="design_definition_ids" widget="many2many_tags"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
