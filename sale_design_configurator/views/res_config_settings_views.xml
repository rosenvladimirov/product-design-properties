<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_design" model="ir.ui.view">
        <field name="name">res.config.settings.form.design</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='mrp_production']" position="after">
                <h2>Design Configurator</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="design_definition_ids"/>
                            <div class="text-muted">
                                Select which design parameter definitions are available for this company.
                                Leave empty to allow all definitions.
                            </div>
                            <field name="design_definition_ids" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
