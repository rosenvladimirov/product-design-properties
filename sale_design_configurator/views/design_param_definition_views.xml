<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="design_param_definition_view_list" model="ir.ui.view">
        <field name="name">design.param.definition.list</field>
        <field name="model">design.param.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="industry"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="design_param_definition_view_form" model="ir.ui.view">
        <field name="name">design.param.definition.form</field>
        <field name="model">design.param.definition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="industry"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parameter Definitions">
                            <field name="design_params_definition"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="design_param_definition_action" model="ir.actions.act_window">
        <field name="name">Design Parameter Definitions</field>
        <field name="res_model">design.param.definition</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu under MRP > Configuration -->
    <menuitem id="menu_design_param_definition"
              name="Design Parameter Sets"
              parent="mrp.menu_mrp_configuration"
              action="design_param_definition_action"
              sequence="55"/>

</odoo>
