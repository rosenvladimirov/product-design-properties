<!-- Copyright 2026 Rosen Vladimirov  (AGPL-3.0-or-later / commercial)

     Design / Sales пише само ДИЗАЙН партидите — тези, които носят дефиниция.
     Търговецът записва партидата от конфигуратора, но няма работа с
     останалите партиди в склада.

     🚨 Правилата по групи се ОБЕДИНЯВАТ. Складовият потребител, който е и в
     Design / Sales, без второто правило щеше да се свие до дизайн партидите
     и да изгуби склада. Затова stock.group_stock_user има правило „всичко“.
-->
<odoo>
    <record id="stock_lot_rule_design_sales" model="ir.rule">
        <field name="name">Design lots: Design / Sales</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('group_design_sales'))]"/>
        <field name="domain_force">[('design_param_definition_id', '!=', False)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="stock_lot_rule_design_stock_user" model="ir.rule">
        <field name="name">Design lots: stock user keeps all lots</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
