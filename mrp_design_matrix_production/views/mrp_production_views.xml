<odoo>
    <record id="mrp_production_form_view_design_config" model="ir.ui.view">
        <field name="name">mrp.production.form.design.config</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Design Configuration"
                      name="design_config"
                      groups="mrp.group_mrp_user">
                    <group>
                        <field name="design_param_definition_id"
                               options="{'no_quick_create': True}"/>
                    </group>
                    <group invisible="not design_param_definition_id">
                        <field name="design_params" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
