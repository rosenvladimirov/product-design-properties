<odoo>

    <record id="view_calibration_form" model="ir.ui.view">
        <field name="name">access.controller.calibration.form</field>
        <field name="model">access.controller.calibration</field>
        <field name="arch" type="xml">
            <form string="Reader Calibration Wizard">
                <header>
                    <button name="action_generate_plan" type="object"
                            string="🧭 Generate Walk Plan" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_reverse_plan" type="object"
                            string="🔄 Reverse Plan Order" class="btn-secondary"
                            invisible="state != 'draft' or not plan_step_ids"
                            help="Reverse the cp order — useful for a second walk in the opposite direction"/>
                    <button name="action_start_walk" type="object"
                            string="🚶 Start Walk" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_stop_walk" type="object"
                            string="⏹ Stop Walk" class="btn-secondary"
                            invisible="state != 'walking'"/>
                    <button name="action_apply" type="object"
                            string="✓ Apply Mapping" class="btn-success"
                            invisible="state != 'walking_done'"/>
                    <button name="action_reset" type="object"
                            string="↺ Reset" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,walking,walking_done,applied"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Workflow:</strong>
                        Pick controllers + card + <b>Starting Position</b>
                        (WHERE YOU ARE NOW: inside or outside the
                        perimeter!) → Generate Walk Plan →
                        edit steps if needed → Start Walk → swipe along
                        the plan → Stop Walk → check preview → Apply.
                        Plan-driven mapping pairs the i-th swipe with the
                        i-th step.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="starting_position">
                        Select <b>Starting Position</b> before Generate
                        Walk Plan — the wizard uses it to derive the
                        first role (entry/exit).
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="card_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="card_number"/>
                            <field name="starting_position"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="controller_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="walk_start"/>
                            <field name="walk_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="🧭 Walk Plan (steps)" name="plan">
                            <field name="plan_step_ids" nolabel="1"
                                   readonly="state not in ('draft','walking_done')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="control_point_id"
                                           options="{'no_create': True}"/>
                                    <field name="role"/>
                                    <field name="matched_event_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="📡 Captured events" name="events">
                            <field name="walk_event_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="ts"/>
                                    <field name="controller_id"/>
                                    <field name="ctrl_id"/>
                                    <field name="reader_no"/>
                                    <field name="control_point_id"/>
                                    <field name="inferred_role"/>
                                </list>
                            </field>
                        </page>
                        <page string="🔍 Preview Mapping" name="preview"
                              invisible="not preview_html">
                            <field name="preview_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_calibration_wizard" model="ir.actions.act_window">
        <field name="name">Reader Calibration Wizard</field>
        <field name="res_model">access.controller.calibration</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_calibration_wizard"
              name="🛠 Reader Calibration"
              parent="hr_attendance_access_control.menu_settings_access_control"
              action="action_calibration_wizard"
              sequence="50"/>

</odoo>
