<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calibration_form" model="ir.ui.view">
        <field name="name">access.controller.calibration.form</field>
        <field name="model">access.controller.calibration</field>
        <field name="arch" type="xml">
            <form string="Reader Calibration Wizard">
                <header>
                    <button name="action_start_route_1" type="object"
                            string="🚶 Start Route 1" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_stop_route_1" type="object"
                            string="⏹ Stop Route 1" class="btn-secondary"
                            invisible="state != 'route_1'"/>
                    <button name="action_start_route_2" type="object"
                            string="🔄 Start Route 2 (reverse)" class="btn-primary"
                            invisible="state != 'route_1_done'"/>
                    <button name="action_stop_route_2" type="object"
                            string="⏹ Stop Route 2" class="btn-secondary"
                            invisible="state != 'route_2'"/>
                    <button name="action_apply" type="object"
                            string="✓ Apply Mapping" class="btn-success"
                            invisible="state != 'route_2_done'"/>
                    <button name="action_reset" type="object"
                            string="↺ Reset" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,route_1,route_1_done,route_2,route_2_done,applied"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Workflow:</strong>
                        Избери controllers и picки картата →
                        Start Route 1 → мини по първи маршрут (CW) → Stop →
                        Start Route 2 → мини обратно (CCW) → Stop →
                        Preview mapping → Apply.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="card_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="card_number"/>
                            <field name="controller_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="route_1_start"/>
                            <field name="route_1_end"/>
                            <field name="route_2_start"/>
                            <field name="route_2_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Route 1 events" name="r1">
                            <field name="route_1_event_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="ts"/>
                                    <field name="controller_id"/>
                                    <field name="ctrl_id"/>
                                    <field name="reader_no"/>
                                    <field name="control_point_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Route 2 events" name="r2">
                            <field name="route_2_event_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="ts"/>
                                    <field name="controller_id"/>
                                    <field name="ctrl_id"/>
                                    <field name="reader_no"/>
                                    <field name="control_point_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Preview Mapping" name="preview"
                              invisible="not preview_html">
                            <field name="preview_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_calibration_wizard" model="ir.actions.act_window">
        <field name="name">Reader Calibration Wizard</field>
        <field name="res_model">access.controller.calibration</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu под Settings → Access Control секцията на legacy app -->
    <menuitem id="menu_calibration_wizard"
              name="🛠 Reader Calibration"
              parent="hr_attendance_access_control.menu_settings_access_control"
              action="action_calibration_wizard"
              sequence="50"/>

</odoo>
