<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_passage_event_list" model="ir.ui.view">
        <field name="name">access.passage.event.list</field>
        <field name="model">access.passage.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-success="result == 'accept' and not anomaly_hint"
                  decoration-warning="result == 'violation' or anomaly_hint"
                  decoration-danger="result == 'deny'">
                <field name="ts"/>
                <field name="controller_id" string="Hardware"
                       optional="show"/>
                <field name="control_point_id" string="Control Point"/>
                <field name="perimeter_id" string="Perimeter"
                       optional="show"/>
                <field name="credential_id" optional="show"/>
                <field name="subject_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="direction"/>
                <field name="time_slot_id" optional="show"/>
                <field name="anomaly_hint" optional="show"/>
                <field name="result"/>
                <field name="violation_count" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_access_passage_event_form" model="ir.ui.view">
        <field name="name">access.passage.event.form</field>
        <field name="model">access.passage.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_direction_svg" type="object"
                                class="oe_stat_button" icon="fa-arrow-right"
                                string="View direction"/>
                    </div>
                    <div class="oe_title">
                        <h2><field name="result"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="ts"/>
                            <field name="control_point_id"/>
                            <field name="perimeter_id"/>
                            <field name="credential_id"/>
                            <field name="subject_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="direction"/>
                            <field name="time_slot_id"/>
                            <field name="anomaly_hint"/>
                            <field name="zen_log_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signal Matrix" name="signal">
                            <field name="signal_matrix" widget="json"
                                   nolabel="1"/>
                        </page>
                        <page string="Context" name="context">
                            <field name="context_in" widget="json"
                                   nolabel="1"/>
                        </page>
                        <page string="Result" name="result">
                            <field name="result_out" widget="json"
                                   nolabel="1"/>
                        </page>
                        <page string="Violations" name="violations"
                              invisible="violation_count == 0">
                            <field name="violation_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Kanban с inline SVG direction icon -->
    <record id="view_access_passage_event_kanban" model="ir.ui.view">
        <field name="name">access.passage.event.kanban</field>
        <field name="model">access.passage.event</field>
        <field name="arch" type="xml">
            <kanban default_order="ts desc" create="false"
                    class="o_kanban_dashboard">
                <field name="result"/>
                <field name="anomaly_hint"/>
                <field name="direction"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2"
                             t-attf-style="border-left: 4px solid {{record.result.raw_value === 'accept' ? '#27AE60' : record.result.raw_value === 'violation' ? '#F39C12' : '#C0392B'}};">
                            <div class="d-flex align-items-center gap-2">
                                <img t-att-src="'/access_control/svg/direction/' + record.id.raw_value"
                                     style="width: 48px; height: 48px;"
                                     alt="dir"/>
                                <div class="flex-grow-1">
                                    <strong>
                                        <field name="control_point_id"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <field name="ts"/>
                                    </div>
                                    <div t-if="record.anomaly_hint.raw_value"
                                         class="text-danger small">
                                        ⚠ <field name="anomaly_hint"/>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-2 small text-muted">
                                <field name="employee_id"/>
                                <span t-if="!record.employee_id.raw_value">
                                    <field name="subject_id"/>
                                </span>
                                · <field name="result"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view — filters + groupby за HR review + анализ -->
    <record id="view_access_passage_event_search" model="ir.ui.view">
        <field name="name">access.passage.event.search</field>
        <field name="model">access.passage.event</field>
        <field name="arch" type="xml">
            <search string="Passage Events">
                <field name="subject_id"/>
                <field name="employee_id"/>
                <field name="perimeter_id"/>
                <field name="control_point_id"/>
                <field name="controller_id"/>
                <field name="credential_id"/>
                <field name="time_slot_id"/>
                <field name="anomaly_hint"/>
                <separator/>
                <filter string="Accepted" name="filter_accept"
                        domain="[('result','=','accept')]"/>
                <filter string="Denied" name="filter_deny"
                        domain="[('result','=','deny')]"/>
                <filter string="Violations" name="filter_violation"
                        domain="[('result','=','violation')]"/>
                <separator/>
                <filter string="Anomalies only" name="filter_anomaly"
                        domain="[('anomaly_hint','!=',False)]"/>
                <filter string="In" name="filter_in"
                        domain="[('direction','=','in')]"/>
                <filter string="Out" name="filter_out"
                        domain="[('direction','=','out')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('ts','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Yesterday" name="filter_yesterday"
                        domain="[('ts','&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=1), datetime.time(0,0,0))),
                                 ('ts','&lt;',  datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Last 7 days" name="filter_week"
                        domain="[('ts','&gt;=', datetime.datetime.now() - relativedelta(days=7))]"/>
                <group>
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Subject" name="group_subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter string="Perimeter" name="group_perimeter"
                            context="{'group_by': 'perimeter_id'}"/>
                    <filter string="Control Point" name="group_point"
                            context="{'group_by': 'control_point_id'}"/>
                    <filter string="Direction" name="group_direction"
                            context="{'group_by': 'direction'}"/>
                    <filter string="Time Slot" name="group_time_slot"
                            context="{'group_by': 'time_slot_id'}"/>
                    <filter string="Result" name="group_result"
                            context="{'group_by': 'result'}"/>
                    <filter string="Anomaly" name="group_anomaly"
                            context="{'group_by': 'anomaly_hint'}"/>
                    <filter string="Hour" name="group_ts_hour"
                            context="{'group_by': 'ts:hour'}"/>
                    <filter string="Day" name="group_ts_day"
                            context="{'group_by': 'ts:day'}"/>
                    <filter string="Week" name="group_ts_week"
                            context="{'group_by': 'ts:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_passage_event" model="ir.actions.act_window">
        <field name="name">Passage Events</field>
        <field name="res_model">access.passage.event</field>
        <field name="view_mode">kanban,list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_access_passage_event_search"/>
    </record>

    <!-- Graph view: passage trend по час -->
    <record id="view_access_passage_event_graph" model="ir.ui.view">
        <field name="name">access.passage.event.graph</field>
        <field name="model">access.passage.event</field>
        <field name="arch" type="xml">
            <graph string="Passage Trend" type="bar" sample="1">
                <field name="ts" interval="hour" type="row"/>
                <field name="result" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Pivot view: passages × perimeter × result -->
    <record id="view_access_passage_event_pivot" model="ir.ui.view">
        <field name="name">access.passage.event.pivot</field>
        <field name="model">access.passage.event</field>
        <field name="arch" type="xml">
            <pivot string="Passage Analytics" sample="1">
                <field name="perimeter_id" type="row"/>
                <field name="ts" interval="day" type="col"/>
                <field name="result" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
