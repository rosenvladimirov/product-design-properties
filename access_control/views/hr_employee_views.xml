<odoo>

    <record id="view_hr_employee_form_passage_trail" model="ir.ui.view">
        <field name="name">hr.employee.form.passage.trail</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_passage_events"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-route"
                        invisible="passage_event_count == 0">
                    <field name="passage_event_count" widget="statinfo"
                           string="Passages"/>
                </button>
                <button name="action_view_trail_svg"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-map-o"
                        invisible="passage_event_count == 0"
                        string="Trail SVG"/>
            </div>
        </field>
    </record>

</odoo>
