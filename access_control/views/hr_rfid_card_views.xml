<odoo>

    <record id="view_hr_rfid_card_form_credential_button" model="ir.ui.view">
        <field name="name">hr.rfid.card.form.credential.button</field>
        <field name="model">hr.rfid.card</field>
        <field name="inherit_id"
               ref="hr_attendance_access_control.view_hr_rfid_card_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_or_create_credential"
                        type="object"
                        string="Open / Create Access Credential"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

</odoo>
