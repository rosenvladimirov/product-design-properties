<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend access.credential form (defined in hr_aac) с subject_id +
         perimeter_ids. Перiметри tab става ПЪРВИ — auto-popula
         controllers в Controllers tab чрез onchange. -->
    <record id="view_access_credential_form_inherit_subject" model="ir.ui.view">
        <field name="name">access.credential.form.inherit.subject</field>
        <field name="model">access.credential</field>
        <field name="inherit_id"
               ref="hr_attendance_access_control.view_access_credential_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holder_partner_id']" position="after">
                <field name="subject_id"/>
            </xpath>
            <!-- Преди Controllers tab → Perimeters tab става първи -->
            <xpath expr="//page[@name='controllers']" position="before">
                <page string="Perimeters" name="perimeters">
                    <field name="perimeter_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           nolabel="1"/>
                    <div class="text-muted mt-2">
                        💡 Изборът тук auto-populate-ва Controllers
                        таба (всички <code>cp.controller_id</code> на
                        active control_points в избраните perimeter-и).
                        Append-only — съществуващи controllers НЕ се
                        махат.
                    </div>
                </page>
            </xpath>
            <!-- Преименувам Controllers → Controllers (auto) за яснота -->
            <xpath expr="//page[@name='controllers']" position="attributes">
                <attribute name="string">Controllers (auto)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
