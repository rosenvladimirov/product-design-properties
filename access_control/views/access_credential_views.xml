<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_credential_form_inherit_subject" model="ir.ui.view">
        <field name="name">access.credential.form.inherit.subject</field>
        <field name="model">access.credential</field>
        <field name="inherit_id"
               ref="hr_attendance_access_control.view_access_credential_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="action_push_to_hardware"
                                type="object"
                                string="Push to Hardware"
                                class="btn-primary"
                                invisible="not active"
                                help="Queue Polimex card.sync commands
                                      for all selected controllers."/>
                    </header>
                </xpath>
                <!-- Replace plain holder_partner_id with kind-aware
                     Holder fields (employee or visitor). Both labelled
                     'Holder'; only the matching one is visible. -->
                <xpath expr="//field[@name='holder_partner_id']"
                       position="before">
                    <field name="holder_kind" widget="radio"
                           options="{'horizontal': True}"/>
                </xpath>
                <!-- Schedule after Valid To -->
                <xpath expr="//field[@name='valid_to']" position="after">
                    <field name="schedule_id"
                           options="{'no_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='holder_partner_id']"
                       position="attributes">
                    <attribute name="string">Holder</attribute>
                    <attribute name="invisible">holder_kind == 'employee'</attribute>
                    <attribute name="options">{'no_create': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='holder_partner_id']"
                       position="after">
                    <field name="holder_employee_id" string="Holder"
                           invisible="holder_kind != 'employee'"
                           options="{'no_create': True}"/>
                    <field name="department_id" readonly="1"
                           invisible="not department_id"/>
                    <field name="subject_id"/>
                </xpath>
                <!-- Perimeters tab in front of Controllers, with
                     auto-populate help text. -->
                <xpath expr="//page[@name='controllers']" position="before">
                    <page string="Perimeters" name="perimeters">
                        <field name="perimeter_ids"
                               widget="many2many_selection"
                               options="{'no_create': True}"
                               nolabel="1"/>
                        <div class="text-muted mt-2">
                            Selecting perimeters here auto-populates the
                            Controllers tab with all
                            <code>cp.controller_id</code> of the active
                            control_points in the selected perimeters.
                            Append-only — existing controllers are kept.
                        </div>
                    </page>
                </xpath>
                <xpath expr="//page[@name='controllers']" position="attributes">
                    <attribute name="string">Controllers (auto)</attribute>
                </xpath>
                <!-- Hardware Sync ledger: per-controller cloud-vs-local
                     storage + D1 rights/schedule + last sync status. -->
                <xpath expr="//page[@name='controllers']" position="after">
                    <page string="Hardware Sync" name="hardware_sync">
                        <field name="credential_controller_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="controller_id"
                                       options="{'no_create': True}"/>
                                <field name="hw_storage"/>
                                <field name="rights_data"/>
                                <field name="rights_mask"/>
                                <field name="ts_code"/>
                                <field name="pin_code"/>
                                <field name="sync_state" readonly="1"
                                       decoration-success="sync_state == 'synced'"
                                       decoration-danger="sync_state == 'failed'"
                                       decoration-muted="sync_state == 'pending'"/>
                                <field name="last_sync" readonly="1"/>
                                <field name="sync_error" readonly="1"
                                       optional="hide"/>
                            </list>
                        </field>
                        <div class="text-muted mt-2">
                            <strong>Local</strong> burns the card into the
                            controller (D1) for offline/standalone
                            validation. <strong>Cloud</strong> validates on
                            the server each read (External DB + proxy ZEN) —
                            no local write. Rows auto-fill from the granted
                            controllers; edit storage per controller, then
                            <em>Push to Hardware</em>.
                        </div>
                    </page>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
