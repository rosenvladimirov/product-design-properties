<odoo>

    <record id="view_hr_department_form_perimeters" model="ir.ui.view">
        <field name="name">hr.department.form.perimeters</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Access Control">
                    <field name="perimeter_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <div class="text-muted">
                        Members of this department automatically get
                        these perimeters when assigned as access
                        credential holders.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
