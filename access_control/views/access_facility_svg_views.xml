<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add "View Live Site Map" button + embedded SVG preview tab
         on access.facility form -->
    <record id="view_access_facility_form_svg" model="ir.ui.view">
        <field name="name">access.facility.form.svg</field>
        <field name="model">access.facility</field>
        <field name="inherit_id"
               ref="hr_attendance_access_control_site_map.view_access_facility_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Live Site Map" name="live_site_map">
                        <button name="action_view_site_svg" type="object"
                                string="Open Live Site Map" class="btn-primary"
                                icon="fa-map"/>
                        <div class="text-muted" style="margin-top: 8px;">
                            ⓘ SVG site map отваря в нов tab. Показва
                            device placements + live state на access
                            points (animation pulse при recent activity
                            в последните 30s). Reload за refresh.
                        </div>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
