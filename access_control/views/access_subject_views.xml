<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_subject_list" model="ir.ui.view">
        <field name="name">access.subject.list</field>
        <field name="model">access.subject</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="employee_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="credential_count" string="Credentials"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_access_subject_form" model="ir.ui.view">
        <field name="name">access.subject.form</field>
        <field name="model">access.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_credentials" type="object"
                                class="oe_stat_button" icon="fa-id-card-o">
                            <field name="credential_count" widget="statinfo"
                                   string="Credentials"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credentials" name="credentials">
                            <field name="credential_ids" nolabel="1">
                                <list>
                                    <field name="credential_kind"/>
                                    <field name="display_name"/>
                                    <field name="valid_to"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Subjects kanban — Real-time view с live occupancy badge -->
    <record id="view_access_subject_kanban" model="ir.ui.view">
        <field name="name">access.subject.kanban</field>
        <field name="model">access.subject</field>
        <field name="arch" type="xml">
            <kanban default_order="last_activity desc"
                    class="o_kanban_dashboard">
                <field name="inside_count"/>
                <field name="current_location"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2"
                             t-attf-style="border-left: 5px solid {{record.inside_count.raw_value > 0 ? '#27AE60' : '#BDC3C7'}};">
                            <div class="d-flex align-items-center gap-2">
                                <span t-attf-class="badge {{record.inside_count.raw_value > 0 ? 'bg-success' : 'bg-light text-dark'}}">
                                    <t t-if="record.inside_count.raw_value &gt; 0">●</t>
                                    <t t-else="">○</t>
                                </span>
                                <strong><field name="name"/></strong>
                            </div>
                            <div t-if="record.inside_count.raw_value &gt; 0"
                                 class="mt-1 small text-success">
                                <i class="fa fa-map-marker" title="location"
                                   role="img" aria-label="location"/>
                                <field name="current_location"/>
                            </div>
                            <div t-else="" class="mt-1 small text-muted">
                                — not on premises
                            </div>
                            <div class="text-muted small mt-1">
                                last: <field name="last_activity"/>
                            </div>
                            <div class="text-muted small">
                                <field name="credential_count"/> credentials
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_access_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">access.subject</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Real-time dashboard alias (same model, default filter) -->
    <record id="action_access_subjects_realtime" model="ir.actions.act_window">
        <field name="name">Real-time Presence</field>
        <field name="res_model">access.subject</field>
        <field name="view_mode">kanban,list</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
