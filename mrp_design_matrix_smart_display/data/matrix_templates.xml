            <field name="type">consu</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
        </record>
        <record id="product_lux_sensor" model="product.template">
            <field name="name">Ambient Light Sensor (O-variant)</field>
            <field name="type">consu</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
        </record>
        <record id="product_proximity_sensor" model="product.template">
