        <!-- Power -->
        <record id="product_psu_mains" model="product.template">
            <field name="name">PSU Module Mains AC (O-variant)</field>
            <field name="type">consu</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
        </record>
        <record id="product_psu_usbc" model="product.template">
            <field name="name">USB-C Power Board (O-variant)</field>
            <field name="type">consu</field>
