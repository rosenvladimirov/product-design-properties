<?xml version="1.0" encoding="utf-8"?>
<!--
    Matrix template records for smart home display panel manufacturing.
    Based on real-world product lines: Sonoff NSPanel Pro, Shelly Wall Display,
    Tuya/Smatek T6E/S8E/T8E.

    T0: Validates hardware compatibility (platform vs display, relay vs power, etc.)
    T1: Derives PCB variant, connector count, power module from platform + features
    T2: Activates O-variant components (Zigbee module, relays, sensors, speakers, etc.)
    T3: Conditional operations (SMT Zigbee, relay soldering, mic calibration, firmware flash, logo print)
-->
<odoo noupdate="1">

        <!-- ── Workcenter stubs ────────────────────────────────────── -->
        <record id="wc_smt" model="mrp.workcenter">
            <field name="name">SMT Assembly Line</field>
            <field name="code">SMT</field>
        </record>
        <record id="wc_display_bond" model="mrp.workcenter">
            <field name="name">Display Bonding</field>
            <field name="code">DBOND</field>
        </record>
        <record id="wc_housing_assembly" model="mrp.workcenter">
            <field name="name">Housing Assembly</field>
            <field name="code">HASM</field>
        </record>
        <record id="wc_firmware_flash" model="mrp.workcenter">
            <field name="name">Firmware Flashing</field>
            <field name="code">FWFL</field>
        </record>
        <record id="wc_logo_print" model="mrp.workcenter">
            <field name="name">Logo Printing</field>
            <field name="code">LOGO</field>
        </record>
        <record id="wc_rf_calibration" model="mrp.workcenter">
            <field name="name">RF Calibration &amp; Test</field>
            <field name="code">RFCAL</field>
        </record>
        <record id="wc_mic_calibration" model="mrp.workcenter">
            <field name="name">Microphone Calibration</field>
            <field name="code">MCAL</field>
        </record>
        <record id="wc_qc" model="mrp.workcenter">
            <field name="name">Quality Control &amp; Burn-in</field>
            <field name="code">QC</field>
        </record>
        <record id="wc_packaging" model="mrp.workcenter">
            <field name="name">Packaging Line</field>
            <field name="code">PACK</field>
        </record>

        <!-- ── Product stubs (O-variants) ──────────────────────────── -->

