        <!-- Attributes for PTAV resolution -->
        <record id="attr_display_size" model="product.attribute">
            <field name="name">Display Size</field>
            <field name="create_variant">no_variant</field>
        </record>
        <record id="attr_val_disp_35" model="product.attribute.value">
            <field name="name">3.5</field>
            <field name="attribute_id" ref="attr_display_size"/>
        </record>
        <record id="attr_val_disp_40" model="product.attribute.value">
            <field name="name">4.0</field>
            <field name="attribute_id" ref="attr_display_size"/>
        </record>
        <record id="attr_val_disp_47" model="product.attribute.value">
            <field name="name">4.7</field>
            <field name="attribute_id" ref="attr_display_size"/>
        </record>
        <record id="attr_val_disp_60" model="product.attribute.value">
            <field name="name">6.0</field>
            <field name="attribute_id" ref="attr_display_size"/>
        </record>
        <record id="attr_val_disp_686" model="product.attribute.value">
            <field name="name">6.86</field>
            <field name="attribute_id" ref="attr_display_size"/>
        </record>
        <record id="attr_val_disp_80" model="product.attribute.value">
            <field name="name">8.0</field>
            <field name="attribute_id" ref="attr_display_size"/>
        </record>
        <record id="attr_val_disp_101" model="product.attribute.value">
