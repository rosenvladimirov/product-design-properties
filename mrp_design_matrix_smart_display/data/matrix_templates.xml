        <!-- ── Matrix template ─────────────────────────────────────── -->
        <record id="matrix_template_smart_display_standard"
                model="mrp.matrix.template">
            <field name="name">Smart Home Display — Standard</field>
            <field name="industry">electronics</field>
            <field name="description">
                Standard template for smart home wall-mount display panels.
                Covers: ESP32/PX30/RK3326/RK3566 platforms, 3.5" to 10.1" displays,
                WiFi/Zigbee/BLE/Z-Wave connectivity, 0-2 relays, sensors,
                audio, housing variants, branding/OEM options.

                T0: Platform-display compatibility, relay-power constraints,
                    ESP32 feature limits.
                T1: Derives PCB variant, power module, connector count.
                T2: O-variant activation for all optional components.
                T3: Conditional operations (RF cal, mic cal, firmware, logo, packaging).
            </field>
            <field name="constraint_table" eval="
                {
                    'nodes': [{
                        'id': 't0-smart-display',
                        'name': 'T0 Constraints',
                        'type': 'decisionTable',
                        'content': {
                            'hitPolicy': 'collect',
                            'inputs': [
                                {'id': 'platform',      'name': 'platform'},
                                {'id': 'display_size',  'name': 'display_size'},
                                {'id': 'has_zigbee',    'name': 'has_zigbee'},
                                {'id': 'has_zwave',     'name': 'has_zwave'},
                                {'id': 'relay_count',   'name': 'relay_count'},
                                {'id': 'power_type',    'name': 'power_type'},
                                {'id': 'mic_count',     'name': 'mic_count'},
                                {'id': 'ram_gb',        'name': 'ram_gb'}
                            ],
                            'outputs': [
                                {'id': 'level',   'name': 'level'},
                                {'id': 'message', 'name': 'message'}
                            ],
                            'rules': [
                                {
                                    'platform':     '&quot;esp32&quot;',
                                    'display_size': '[&quot;6.0&quot;,&quot;6.86&quot;,&quot;8.0&quot;,&quot;10.1&quot;]',
                                    'level':   '&quot;error&quot;',
                                    'message': '&quot;ESP32 cannot drive displays larger than 4.7 inch. Use PX30 or RK platform.&quot;'
                                },
                                {
                                    'platform':   '&quot;esp32&quot;',
                                    'has_zigbee': 'true',
                                    'has_zwave':  'true',
                                    'level':   '&quot;error&quot;',
                                    'message': '&quot;ESP32 does not support simultaneous Zigbee + Z-Wave. Choose one.&quot;'
                                },
                                {
                                    'relay_count': '&quot;2&quot;',
                                    'power_type':  '&quot;usb_c&quot;',
                                    'level':   '&quot;error&quot;',
                                    'message': '&quot;USB-C power insufficient for 2 relays. Use mains or PoE.&quot;'
                                },
                                {
                                    'platform':  '&quot;esp32&quot;',
                                    'mic_count': '[&quot;2&quot;,&quot;4&quot;]',
                                    'level':   '&quot;error&quot;',
                                    'message': '&quot;ESP32 supports max 1 microphone. Use Android platform for mic array.&quot;'
                                },
                                {
                                    'platform': '&quot;esp32&quot;',
                                    'ram_gb':   '[&quot;2&quot;,&quot;4&quot;]',
                                    'level':   '&quot;error&quot;',
                                    'message': '&quot;ESP32 has fixed 512KB SRAM. RAM selection applies only to Android platforms.&quot;'
                                },
                                {
                                    'display_size': '[&quot;8.0&quot;,&quot;10.1&quot;]',
                                    'power_type':   '&quot;usb_c&quot;',
                                    'level':   '&quot;warning&quot;',
                                    'message': '&quot;Large display with USB-C: verify power budget. Mains recommended.&quot;'
                                },
                                {
                                    'has_zigbee': 'true',
                                    'has_zwave':  'true',
                                    'level':   '&quot;warning&quot;',
                                    'message': '&quot;Zigbee + Z-Wave: verify antenna isolation on PCB layout.&quot;'
                                }
                            ]
                        }
                    }]
                }
            "/>
            <field name="geometry_table" eval="
                {
                    'nodes': [{
                        'id': 't1-smart-display',
                        'name': 'T1 Geometry / Derived',
                        'type': 'decisionTable',
                        'content': {
                            'hitPolicy': 'first',
                            'inputs': [
                                {'id': 'platform',     'name': 'platform'},
                                {'id': 'has_zigbee',   'name': 'has_zigbee'},
                                {'id': 'has_zwave',    'name': 'has_zwave'},
                                {'id': 'relay_count',  'name': 'relay_count'},
                                {'id': 'power_type',   'name': 'power_type'}
                            ],
                            'outputs': [
                                {'id': 'radio_module_count', 'name': 'radio_module_count'},
                                {'id': 'needs_rf_shielding', 'name': 'needs_rf_shielding'},
                                {'id': 'total_antenna_count', 'name': 'total_antenna_count'}
                            ],
                            'rules': [
                                {
                                    'has_zigbee': 'true', 'has_zwave': 'true',
                                    'radio_module_count': '3',
                                    'needs_rf_shielding': 'true',
                                    'total_antenna_count': '3'
                                },
                                {
                                    'has_zigbee': 'true', 'has_zwave': 'false',
                                    'radio_module_count': '2',
                                    'needs_rf_shielding': 'false',
                                    'total_antenna_count': '2'
                                },
                                {
                                    'has_zigbee': 'false', 'has_zwave': 'true',
                                    'radio_module_count': '2',
                                    'needs_rf_shielding': 'false',
                                    'total_antenna_count': '2'
                                },
                                {
                                    'has_zigbee': 'false', 'has_zwave': 'false',
                                    'radio_module_count': '1',
                                    'needs_rf_shielding': 'false',
                                    'total_antenna_count': '1'
                                }
                            ]
                        }
                    }]
                }
            "/>
            <field name="material_table" eval="
                {
                    'nodes': [{
                        'id': 't2-smart-display',
                        'name': 'T2 Materials',
                        'type': 'decisionTable',
                        'content': {
                            'hitPolicy': 'collect',
                            'inputs': [
                                {'id': 'has_zigbee',         'name': 'has_zigbee'},
                                {'id': 'has_zwave',          'name': 'has_zwave'},
                                {'id': 'relay_count',        'name': 'relay_count'},
                                {'id': 'has_temp_sensor',    'name': 'has_temp_sensor'},
                                {'id': 'has_humidity_sensor','name': 'has_humidity_sensor'},
                                {'id': 'has_lux_sensor',     'name': 'has_lux_sensor'},
                                {'id': 'has_proximity',      'name': 'has_proximity'},
                                {'id': 'speaker_count',      'name': 'speaker_count'},
                                {'id': 'mic_count',          'name': 'mic_count'}
                            ],
                            'outputs': [
                                {'id': 'bom_line_coeff_key', 'name': 'bom_line_coeff_key'},
                                {'id': 'coefficient',        'name': 'coefficient'}
                            ],
                            'rules': [
                                {'has_zigbee': 'true',
                                 'bom_line_coeff_key': '&quot;zigbee-o&quot;', 'coefficient': '1.0'},
                                {'has_zwave': 'true',
                                 'bom_line_coeff_key': '&quot;zwave-o&quot;', 'coefficient': '1.0'},
                                {'relay_count': '&quot;1&quot;',
                                 'bom_line_coeff_key': '&quot;relay-o&quot;', 'coefficient': '1.0'},
                                {'relay_count': '&quot;2&quot;',
                                 'bom_line_coeff_key': '&quot;relay-o&quot;', 'coefficient': '2.0'},
                                {'has_temp_sensor': 'true',
                                 'bom_line_coeff_key': '&quot;temp-humidity-o&quot;', 'coefficient': '1.0'},
                                {'has_lux_sensor': 'true',
                                 'bom_line_coeff_key': '&quot;lux-o&quot;', 'coefficient': '1.0'},
                                {'has_proximity': 'true',
                                 'bom_line_coeff_key': '&quot;proximity-o&quot;', 'coefficient': '1.0'},
                                {'speaker_count': '&quot;1&quot;',
                                 'bom_line_coeff_key': '&quot;speaker-o&quot;', 'coefficient': '1.0'},
                                {'speaker_count': '&quot;2&quot;',
                                 'bom_line_coeff_key': '&quot;speaker-o&quot;', 'coefficient': '2.0'},
                                {'mic_count': '&quot;1&quot;',
                                 'bom_line_coeff_key': '&quot;mic-o&quot;', 'coefficient': '1.0'},
                                {'mic_count': '&quot;2&quot;',
                                 'bom_line_coeff_key': '&quot;mic-o&quot;', 'coefficient': '2.0'},
                                {'mic_count': '&quot;4&quot;',
                                 'bom_line_coeff_key': '&quot;mic-o&quot;', 'coefficient': '4.0'}
                            ]
                        }
                    }]
                }
            "/>
            <field name="operation_table" eval="
                {
                    'nodes': [{
                        'id': 't3-smart-display',
                        'name': 'T3 Operations',
                        'type': 'decisionTable',
                        'content': {
                            'hitPolicy': 'collect',
                            'inputs': [
                                {'id': 'has_zigbee',        'name': 'has_zigbee'},
                                {'id': 'has_zwave',         'name': 'has_zwave'},
                                {'id': 'mic_count',         'name': 'mic_count'},
                                {'id': 'has_custom_logo',   'name': 'has_custom_logo'},
                                {'id': 'has_custom_firmware','name': 'has_custom_firmware'},
                                {'id': 'has_custom_packaging','name': 'has_custom_packaging'}
                            ],
                            'outputs': [
                                {'id': 'workcenter_ref',   'name': 'workcenter_ref'},
                                {'id': 'duration_formula', 'name': 'duration_formula'},
                                {'id': 'sequence',         'name': 'sequence'}
                            ],
                            'rules': [
                                {
                                    'has_zigbee': 'true',
                                    'workcenter_ref': '&quot;mrp_design_matrix_smart_display.wc_rf_calibration&quot;',
                                    'duration_formula': '&quot;2.0&quot;',
                                    'sequence': '30'
                                },
                                {
                                    'has_zwave': 'true',
                                    'workcenter_ref': '&quot;mrp_design_matrix_smart_display.wc_rf_calibration&quot;',
                                    'duration_formula': '&quot;3.0&quot;',
                                    'sequence': '31'
                                },
                                {
                                    'mic_count': '[&quot;2&quot;,&quot;4&quot;]',
                                    'workcenter_ref': '&quot;mrp_design_matrix_smart_display.wc_mic_calibration&quot;',
                                    'duration_formula': '&quot;1.5&quot;',
                                    'sequence': '35'
                                },
                                {
                                    'has_custom_firmware': 'true',
                                    'workcenter_ref': '&quot;mrp_design_matrix_smart_display.wc_firmware_flash&quot;',
                                    'duration_formula': '&quot;5.0&quot;',
                                    'sequence': '40'
                                },
                                {
                                    'has_custom_logo': 'true',
                                    'workcenter_ref': '&quot;mrp_design_matrix_smart_display.wc_logo_print&quot;',
                                    'duration_formula': '&quot;1.0&quot;',
                                    'sequence': '50'
                                },
                                {
                                    'has_custom_packaging': 'true',
                                    'workcenter_ref': '&quot;mrp_design_matrix_smart_display.wc_packaging&quot;',
                                    'duration_formula': '&quot;2.0&quot;',
                                    'sequence': '60'
                                }
                            ]
                        }
                    }]
                }
            "/>
        </record>

    </odoo>
