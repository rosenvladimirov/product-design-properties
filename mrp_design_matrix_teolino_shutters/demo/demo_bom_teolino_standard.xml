  </record>

  <!-- ── Demo BoM ──────────────────────────────────────────────────────── -->
  <record id="bom_teolino_shutter" model="mrp.bom">
    <field name="product_tmpl_id" ref="product_tmpl_teolino_shutter"/>
    <field name="product_qty">1</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="type">normal</field>
    <!-- NOTE: следва точно конвенцията на roller_door / bags. `ref(xmlid)`
         в Odoo 18 eval връща int, а base парсерът не регистрира ir.model.data
         за definition-а → това е известна repo-wide demo крехкост (виж
         README „Known limitations"), НЕ специфична за този модул. -->
    <field name="design_param_definition_id"
           ref="mrp_design_matrix_teolino_shutters.teolino_shutters"/>
    <field name="matrix_template_id"
           ref="matrix_template_teolino_shutters"/>
    <field name="constraint_table" eval="
        ref('matrix_template_teolino_shutters').constraint_table
    "/>
    <field name="geometry_table" eval="
        ref('matrix_template_teolino_shutters').geometry_table
    "/>
    <field name="material_table" eval="
        ref('matrix_template_teolino_shutters').material_table
    "/>
    <field name="operation_table" eval="
        ref('matrix_template_teolino_shutters').operation_table
    "/>
  </record>

  <!-- ── BoM lines (model-aware) ───────────────────────────────────────── -->

  <!-- AL Guide: per guide_mode.
       h_minus_box  (std/round): 2 × (H - box_mm) / 1000 m
       h_minus_1    (built_in) : 2 × (H - 1)      / 1000 m
       fixed_pvc    (t_roll)   : 2 × (H - box_mm) / 1000 m (703062 PVC double)
       thermo_sel   (thermo)   : standard 703001 ред (feather → O-вариант) -->
  <record id="bl_teo_al_guide" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_al_guide"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
box_mm = int(box_size) if box_size not in ('none', '', None) else 0
if guide_mode == 'h_minus_1':
    base = 2 * (height - 1)
else:
    base = 2 * (height - box_mm)
quantity = base / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Brush Guide: AL Guide × 2 (built_in: 4 × (H-1)) -->
  <record id="bl_teo_brush_guide" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_brush_guide"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
box_mm = int(box_size) if box_size not in ('none', '', None) else 0
if guide_mode == 'h_minus_1':
    base = 4 * (height - 1)
else:
    base = 4 * (height - box_mm)
quantity = base / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Slat: slat_count × (L - slat_len_offset) / 1000 linear m -->
  <record id="bl_teo_slat" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_slat"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
import math
slat = int(slat_size)
box_mm = int(box_size) if box_size not in ('none', '', None) else 0
off = int(slat_len_offset)
if slat_count_mode == 'builtin':
    n_slats = math.ceil(height / slat) - 1
elif slat_count_mode == 'thermo':
    n_slats = math.floor((height - box_mm / 2) / slat) + (1 if slat == 50 else 0)
else:  # std (standard / round / t_roll)
    n_slats = math.floor((height - box_mm / 2) / slat) - 1
quantity = n_slats * (width - off) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Terminal (bottom bar): (L - terminal_offset) / 1000 m -->
  <record id="bl_teo_terminal" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_terminal"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (width - int(terminal_offset)) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Gasket: same length as terminal -->
  <record id="bl_teo_gasket" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_gasket"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
quantity = (width - int(terminal_offset)) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Main Box: (L - box_form_offset) / 1000 m. Built-In = НЯМА кутия → 0. -->
  <record id="bl_teo_box" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_box"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
if shutter_model == 'built_in' or box_size in ('none', '', None):
    quantity = 0.0
else:
    quantity = (width - int(box_form_offset)) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Axis: (L - axis_off) / 1000 m ; axis_off по axis_size (T1: axis_off_40/60) -->
  <record id="bl_teo_axis" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_axis"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
axis_off = int(axis_off_60) if int(axis_size) == 60 else int(axis_off_40)
quantity = (width - axis_off) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- End Cap: 1 set (Built-In: НЯМА кутия → 0) -->
  <record id="bl_teo_end_cap" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_end_cap"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
quantity = (0.0 if shutter_model == 'built_in' else 1.0) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Safety Plate: 1 -->
  <record id="bl_teo_safety_plate" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_safety_plate"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Pulley: 1 (Thermo: ВИНАГИ 1, не motor-reduced — вече е 1) -->
  <record id="bl_teo_pulley" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_pulley"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Caps: caps_mode. n1: n_slats+1 ; equal/direct: = n_slats -->
  <record id="bl_teo_caps" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_caps"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
import math
slat = int(slat_size)
box_mm = int(box_size) if box_size not in ('none', '', None) else 0
if slat_count_mode == 'builtin':
    n_slats = math.ceil(height / slat) - 1
elif slat_count_mode == 'thermo':
    n_slats = math.floor((height - box_mm / 2) / slat) + (1 if slat == 50 else 0)
else:
    n_slats = math.floor((height - box_mm / 2) / slat) - 1
caps = n_slats + 1 if caps_mode == 'n1' else n_slats
quantity = caps * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Ball Bearing: 2 (Thermo: ВИНАГИ 1 — locked S1-S4) -->
  <record id="bl_teo_bearing" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_bearing"/>
    <field name="product_qty">2.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
quantity = (1.0 if shutter_model == 'thermo_comfort' else 2.0) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Cup: 1 per axis end (Thermo: Cup ВИНАГИ се добавя, SKU per axis) -->
  <record id="bl_teo_cup" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_cup"/>
    <field name="product_qty">2.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Entry Guide: 1 -->
  <record id="bl_teo_entry_guide" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_entry_guide"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Security Spring:
       std/thermo : max(2, floor((H - box_mm)/500) + 1)
       t_roll     : shutter_count × ceil(L/500)
       built_in   : 2 (без кутия) -->
  <record id="bl_teo_sec_spring" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_sec_spring"/>
    <field name="product_qty">2.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
import math
box_mm = int(box_size) if box_size not in ('none', '', None) else 0
sc = int(shutter_count)
if shutter_model == 't_roll':
    qty = sc * math.ceil(width / 500)
elif shutter_model == 'built_in':
    qty = 2
else:
    qty = max(2, math.floor((height - box_mm) / 500) + 1)
quantity = qty * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Rivet 3×8: 10 (box-level; Built-In без кутия → 0) -->
  <record id="bl_teo_rivet_3x8" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_rivet_3x8"/>
    <field name="product_qty">10.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
quantity = (0.0 if shutter_model == 'built_in' else 10.0) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Rivet 4×10: 10 (box-level; Built-In → 0) -->
  <record id="bl_teo_rivet_4x10" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_rivet_4x10"/>
    <field name="product_qty">10.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
quantity = (0.0 if shutter_model == 'built_in' else 10.0) * product_uom_qty
    </field>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- Package: 1 -->
  <record id="bl_teo_package" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_package"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">1.0</field>
  </record>

  <!-- ── O-variants ────────────────────────────────────────────────────── -->

  <!-- Cord kit [rope-o]: × meters (брой щори × дължина-фактор) -->
  <record id="bl_teo_rope_kit" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_rope_kit"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
quantity = int(shutter_count) * product_uom_qty
    </field>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">rope-o</field>
  </record>

  <!-- Tape (shirit) kit [shirit-o] -->
  <record id="bl_teo_shirit_kit" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_shirit_kit"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="quantity_formula">
quantity = int(shutter_count) * product_uom_qty
    </field>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">shirit-o</field>
  </record>

  <!-- Standard motor [motor-o] (не-Thermo) -->
  <record id="bl_teo_motor" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_motor"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">motor-o</field>
  </record>

  <!-- Safety motor [motor_safety-o] (Thermo Comfort) -->
  <record id="bl_teo_motor_safety" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_motor_safety"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_unit"/>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">motor_safety-o</field>
  </record>

  <!-- Feather guide [guide_feather-o] (Thermo Comfort): замества стандартния
       водач; дължина = 2 × (H - box_mm) / 1000 m -->
  <record id="bl_teo_guide_feather" model="mrp.bom.line">
    <field name="bom_id" ref="bom_teolino_shutter"/>
    <field name="product_id" ref="product_tmpl_teo_guide_feather"/>
    <field name="product_qty">1.0</field>
    <field name="product_uom_id" ref="uom.product_uom_meter"/>
    <field name="quantity_formula">
box_mm = int(box_size) if box_size not in ('none', '', None) else 0
quantity = 2 * (height - box_mm) / 1000 * product_uom_qty
    </field>
    <field name="coeff_default">0.0</field>
    <field name="matrix_coeff_rule">guide_feather-o</field>
  </record>

</odoo>
