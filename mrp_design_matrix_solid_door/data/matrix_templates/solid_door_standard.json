{
  "nodes": [
    {
      "id": "t0-solid",
      "name": "T0 Constraints",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "width",       "name": "width"},
          {"id": "height",      "name": "height"},
          {"id": "slab_type",   "name": "slab_type"},
          {"id": "line_type",   "name": "line_type"},
          {"id": "fire_rated",  "name": "fire_rated"},
          {"id": "door_model",  "name": "door_model"}
        ],
        "outputs": [
          {"id": "level",   "name": "level"},
          {"id": "message", "name": "message"}
        ],
        "rules": [
          {
            "width": "< 900", "height": "", "slab_type": "", "line_type": "", "fire_rated": "", "door_model": "",
            "level":   "\"error\"",
            "message": "\"Minimum width for armored entrance door is 900 mm.\""
          },
          {
            "width": "> 1020", "height": "", "slab_type": "", "line_type": "", "fire_rated": "", "door_model": "",
            "level":   "\"error\"",
            "message": "\"Maximum width is 1020 mm. Standard sizes: 900, 940, 980, 1020 mm.\""
          },
          {
            "width": "", "height": "< 1980", "slab_type": "", "line_type": "", "fire_rated": "", "door_model": "",
            "level":   "\"error\"",
            "message": "\"Minimum height for armored entrance door is 1980 mm.\""
          },
          {
            "width": "", "height": "> 2100", "slab_type": "", "line_type": "", "fire_rated": "", "door_model": "",
            "level":   "\"error\"",
            "message": "\"Maximum height is 2100 mm. Standard sizes: 1980, 2020, 2060, 2100 mm.\""
          },
          {
            "width": "", "height": "", "slab_type": "\"Без\"", "line_type": "!= \"Без\"", "fire_rated": "", "door_model": "",
            "level":   "\"error\"",
            "message": "\"Plain slab cannot have decorative lines — set line_type to Без.\""
          },
          {
            "width": "", "height": "", "slab_type": "", "line_type": "", "fire_rated": "true", "door_model": "\"iDoor\",\"iDoor_3_0\",\"B_Smart\"",
            "level":   "\"error\"",
            "message": "\"EI60 fire rating not available for this model — use Klasik EI60 series.\""
          },
          {
            "width": "", "height": "", "slab_type": "", "line_type": "", "fire_rated": "", "door_model": "\"Klasik_EI60\",\"Klasik_EI60i\"",
            "level":   "\"warning\"",
            "message": "\"EI60 fire-rated model — slab weight increased, longer assembly time.\""
          }
        ]
      }
    },
    {
      "id": "t1-solid",
      "name": "T1 Geometry - weight and hinge count",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "first",
        "inputs": [
          {"id": "door_model", "name": "door_model"},
          {"id": "fire_rated", "name": "fire_rated"}
        ],
        "outputs": [
          {"id": "hinge_count",     "name": "hinge_count"},
          {"id": "slab_weight_kg",  "name": "slab_weight_kg"},
          {"id": "locking_points",  "name": "locking_points"}
        ],
        "rules": [
          {"door_model": "\"iDoor_3_0\"",                       "fire_rated": "",     "hinge_count": "3", "slab_weight_kg": "80", "locking_points": "18"},
          {"door_model": "\"iDoor_HH\"",                        "fire_rated": "",     "hinge_count": "2", "slab_weight_kg": "75", "locking_points": "8"},
          {"door_model": "\"iDoor\"",                            "fire_rated": "",     "hinge_count": "2", "slab_weight_kg": "70", "locking_points": "12"},
          {"door_model": "\"mySolid_HH\",\"mySolid_HHi\"",     "fire_rated": "",     "hinge_count": "2", "slab_weight_kg": "75", "locking_points": "12"},
          {"door_model": "\"Solid_Alpha\",\"Solid_Pulse\"",     "fire_rated": "",     "hinge_count": "2", "slab_weight_kg": "70", "locking_points": "12"},
          {"door_model": "\"Klasik_EI60\",\"Klasik_EI60i\"",   "fire_rated": "",     "hinge_count": "3", "slab_weight_kg": "90", "locking_points": "9"},
          {"door_model": "\"B_Smart\",\"B_Smart_KK\"",         "fire_rated": "",     "hinge_count": "2", "slab_weight_kg": "60", "locking_points": "9"},
          {"door_model": "",                                     "fire_rated": "",     "hinge_count": "2", "slab_weight_kg": "65", "locking_points": "9"}
        ]
      }
    },
    {
      "id": "t2-solid",
      "name": "T2 Materials - O-variant activation",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "handle_type", "name": "handle_type"},
          {"id": "lock_type",   "name": "lock_type"},
          {"id": "extras",      "name": "extras"},
          {"id": "has_glass",   "name": "has_glass"}
        ],
        "outputs": [
          {"id": "component", "name": "component"},
          {"id": "coeff",     "name": "coeff"}
        ],
        "rules": [
          {"handle_type": "!= \"\"", "lock_type": "",        "extras": "",            "has_glass": "",     "component": "\"handle-o\"",  "coeff": "1"},
          {"handle_type": "",        "lock_type": "!= \"\"", "extras": "",            "has_glass": "",     "component": "\"lock-o\"",    "coeff": "1"},
          {"handle_type": "",        "lock_type": "",        "extras": "contains \"seal\"", "has_glass": "", "component": "\"seal-o\"",    "coeff": "1"},
          {"handle_type": "",        "lock_type": "",        "extras": "contains \"peephole\"", "has_glass": "", "component": "\"peephole-o\"", "coeff": "1"},
          {"handle_type": "",        "lock_type": "",        "extras": "",            "has_glass": "true", "component": "\"glass-o\"",   "coeff": "1"}
        ]
      }
    },
    {
      "id": "t3-solid",
      "name": "T3 Operations",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "coating",    "name": "coating"},
          {"id": "fire_rated", "name": "fire_rated"},
          {"id": "door_model", "name": "door_model"}
        ],
        "outputs": [
          {"id": "workcenter_code", "name": "workcenter_code"},
          {"id": "duration_min",    "name": "duration_min"}
        ],
        "rules": [
          {"coating": "contains \"3D\"", "fire_rated": "",     "door_model": "", "workcenter_code": "\"SDMILL\"", "duration_min": "20"},
          {"coating": "",                "fire_rated": "true", "door_model": "", "workcenter_code": "\"SDFIRE\"", "duration_min": "30"},
          {"coating": "",                "fire_rated": "",     "door_model": "", "workcenter_code": "\"SDASM\"",  "duration_min": "60"},
          {"coating": "",                "fire_rated": "",     "door_model": "", "workcenter_code": "\"SDFIN\"",  "duration_min": "30"}
        ]
      }
    }
  ]
}
