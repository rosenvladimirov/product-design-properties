<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Workcenters -->
    <record id="wc_slab_milling" model="mrp.workcenter">
        <field name="name">Slab Milling &amp; CNC</field>
        <field name="code">SDMILL</field>
    </record>
    <record id="wc_assembly" model="mrp.workcenter">
        <field name="name">Door Assembly</field>
        <field name="code">SDASM</field>
    </record>
    <record id="wc_surface_finishing" model="mrp.workcenter">
        <field name="name">Surface Finishing (3D coating)</field>
        <field name="code">SDFIN</field>
    </record>
    <record id="wc_fire_test" model="mrp.workcenter">
        <field name="name">Fire-Rated Certification</field>
        <field name="code">SDFIRE</field>
    </record>
    <record id="wc_frame_bending" model="mrp.workcenter">
        <field name="name">Frame Bending &amp; Welding</field>
        <field name="code">SDFRM</field>
    </record>

    <!-- Matrix template — JSON content mirrors
         data/matrix_templates/solid_door_standard.json.
         Stored here as Odoo data so the template is available
         immediately after installation without a file-read step.
         All 18 models are armored entrance doors (Solid 55).
         Standard sizes: width 900-1020mm, height 1980-2100mm. -->
    <record id="matrix_template_solid_door" model="mrp.matrix.template">
        <field name="name">Solid Door — Standard</field>
        <field name="industry">doors</field>
        <field name="description">
            Template for SolidDoor armored entrance door range (Solid 55).
            T0: width 900-1020mm, height 1980-2100mm, slab-line compat, fire-rated model check.
            T1: hinge count, slab weight, locking points per model.
            T2: O-variant activation for handle, lock, glass, extras (seal, peephole).
            T3: operation assignment (milling for 3D coatings, fire test for EI60, assembly, finishing).
        </field>
        <field name="constraint_table" eval="
            {
                'nodes': [{
                    'id': 't0-solid',
                    'name': 'T0 Constraints',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'collect',
                        'inputs': [
                            {'id': 'width',      'name': 'width'},
                            {'id': 'height',     'name': 'height'},
                            {'id': 'slab_type',  'name': 'slab_type'},
                            {'id': 'line_type',  'name': 'line_type'},
                            {'id': 'fire_rated', 'name': 'fire_rated'},
                            {'id': 'door_model', 'name': 'door_model'}
                        ],
                        'outputs': [
                            {'id': 'level',   'name': 'level'},
                            {'id': 'message', 'name': 'message'}
                        ],
                        'rules': [
                            {'width': '&lt; 900', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Minimum width for armored entrance door is 900 mm.&quot;'},
                            {'width': '&gt; 1020', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Maximum width is 1020 mm. Standard sizes: 900, 940, 980, 1020 mm.&quot;'},
                            {'width': '', 'height': '&lt; 1980', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Minimum height for armored entrance door is 1980 mm.&quot;'},
                            {'width': '', 'height': '&gt; 2100', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Maximum height is 2100 mm. Standard sizes: 1980, 2020, 2060, 2100 mm.&quot;'},
                            {'width': '', 'height': '', 'slab_type': '&quot;Без&quot;', 'line_type': '!= &quot;Без&quot;', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Plain slab cannot have decorative lines — set line_type to Без.&quot;'},
                            {'width': '', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': 'true', 'door_model': '&quot;iDoor&quot;,&quot;iDoor_3_0&quot;,&quot;B_Smart&quot;',
                             'level': '&quot;error&quot;', 'message': '&quot;EI60 fire rating not available for this model — use Klasik EI60 series.&quot;'},
                            {'width': '', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '&quot;Klasik_EI60&quot;,&quot;Klasik_EI60i&quot;',
                             'level': '&quot;warning&quot;', 'message': '&quot;EI60 fire-rated model — slab weight increased, longer assembly time.&quot;'}
                        ]
                    }
                }]
            }
        "/>
        <field name="geometry_table" eval="
            {
                'nodes': [{
                    'id': 't1-solid',
                    'name': 'T1 Geometry - weight, hinges, locking points',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'first',
                        'inputs': [
                            {'id': 'door_model', 'name': 'door_model'},
                            {'id': 'fire_rated', 'name': 'fire_rated'}
                        ],
                        'outputs': [
                            {'id': 'hinge_count',    'name': 'hinge_count'},
                            {'id': 'slab_weight_kg', 'name': 'slab_weight_kg'},
                            {'id': 'locking_points', 'name': 'locking_points'}
                        ],
                        'rules': [
                            {'door_model': '&quot;iDoor_3_0&quot;',                                          'fire_rated': '', 'hinge_count': '3', 'slab_weight_kg': '80', 'locking_points': '18'},
                            {'door_model': '&quot;iDoor_HH&quot;',                                           'fire_rated': '', 'hinge_count': '2', 'slab_weight_kg': '75', 'locking_points': '8'},
                            {'door_model': '&quot;iDoor&quot;',                                               'fire_rated': '', 'hinge_count': '2', 'slab_weight_kg': '70', 'locking_points': '12'},
                            {'door_model': '&quot;mySolid_HH&quot;,&quot;mySolid_HHi&quot;',                 'fire_rated': '', 'hinge_count': '2', 'slab_weight_kg': '75', 'locking_points': '12'},
                            {'door_model': '&quot;Solid_Alpha&quot;,&quot;Solid_Pulse&quot;',                 'fire_rated': '', 'hinge_count': '2', 'slab_weight_kg': '70', 'locking_points': '12'},
                            {'door_model': '&quot;Klasik_EI60&quot;,&quot;Klasik_EI60i&quot;',               'fire_rated': '', 'hinge_count': '3', 'slab_weight_kg': '90', 'locking_points': '9'},
                            {'door_model': '&quot;B_Smart&quot;,&quot;B_Smart_KK&quot;',                     'fire_rated': '', 'hinge_count': '2', 'slab_weight_kg': '60', 'locking_points': '9'},
                            {'door_model': '',                                                                'fire_rated': '', 'hinge_count': '2', 'slab_weight_kg': '65', 'locking_points': '9'}
                        ]
                    }
                }]
            }
        "/>
        <field name="material_table" eval="
            {
                'nodes': [{
                    'id': 't2-solid',
                    'name': 'T2 Materials - O-variant activation',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'collect',
                        'inputs': [
                            {'id': 'handle_type', 'name': 'handle_type'},
                            {'id': 'lock_type',   'name': 'lock_type'},
                            {'id': 'extras',      'name': 'extras'},
                            {'id': 'has_glass',   'name': 'has_glass'}
                        ],
                        'outputs': [
                            {'id': 'component', 'name': 'component'},
                            {'id': 'coeff',     'name': 'coeff'}
                        ],
                        'rules': [
                            {'handle_type': '!= &quot;&quot;', 'lock_type': '',             'extras': '',                          'has_glass': '',     'component': '&quot;handle-o&quot;',  'coeff': '1'},
                            {'handle_type': '',              'lock_type': '!= &quot;&quot;', 'extras': '',                          'has_glass': '',     'component': '&quot;lock-o&quot;',    'coeff': '1'},
                            {'handle_type': '',              'lock_type': '',               'extras': 'contains &quot;seal&quot;',  'has_glass': '',     'component': '&quot;seal-o&quot;',    'coeff': '1'},
                            {'handle_type': '',              'lock_type': '',               'extras': 'contains &quot;peephole&quot;', 'has_glass': '',  'component': '&quot;peephole-o&quot;', 'coeff': '1'},
                            {'handle_type': '',              'lock_type': '',               'extras': '',                          'has_glass': 'true', 'component': '&quot;glass-o&quot;',   'coeff': '1'}
                        ]
                    }
                }]
            }
        "/>
        <field name="operation_table" eval="
            {
                'nodes': [{
                    'id': 't3-solid',
                    'name': 'T3 Operations',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'collect',
                        'inputs': [
                            {'id': 'coating',    'name': 'coating'},
                            {'id': 'fire_rated', 'name': 'fire_rated'},
                            {'id': 'door_model', 'name': 'door_model'}
                        ],
                        'outputs': [
                            {'id': 'workcenter_code', 'name': 'workcenter_code'},
                            {'id': 'duration_min',    'name': 'duration_min'}
                        ],
                        'rules': [
                            {'coating': 'contains &quot;3D&quot;', 'fire_rated': '',     'door_model': '', 'workcenter_code': '&quot;SDMILL&quot;', 'duration_min': '20'},
                            {'coating': '',                        'fire_rated': 'true', 'door_model': '', 'workcenter_code': '&quot;SDFIRE&quot;', 'duration_min': '30'},
                            {'coating': '',                        'fire_rated': '',     'door_model': '', 'workcenter_code': '&quot;SDASM&quot;',  'duration_min': '60'},
                            {'coating': '',                        'fire_rated': '',     'door_model': '', 'workcenter_code': '&quot;SDFIN&quot;',  'duration_min': '30'}
                        ]
                    }
                }]
            }
        "/>
    </record>
</odoo>
