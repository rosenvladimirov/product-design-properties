<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Workcenters -->
    <record id="wc_slab_milling" model="mrp.workcenter">
        <field name="name">Slab Milling &amp; CNC</field>
        <field name="code">SDMILL</field>
    </record>
    <record id="wc_assembly" model="mrp.workcenter">
        <field name="name">Door Assembly</field>
        <field name="code">SDASM</field>
    </record>
    <record id="wc_surface_finishing" model="mrp.workcenter">
        <field name="name">Surface Finishing (3D coating)</field>
        <field name="code">SDFIN</field>
    </record>
    <record id="wc_fire_test" model="mrp.workcenter">
        <field name="name">Fire-Rated Certification</field>
        <field name="code">SDFIRE</field>
    </record>
    <record id="wc_frame_bending" model="mrp.workcenter">
        <field name="name">Frame Bending &amp; Welding</field>
        <field name="code">SDFRM</field>
    </record>

    <!-- Matrix template — JSON content mirrors
         data/matrix_templates/solid_door_standard.json.
         Stored here as Odoo data so the template is available
         immediately after installation without a file-read step. -->
    <record id="matrix_template_solid_door" model="mrp.matrix.template">
        <field name="name">Solid Door — Standard</field>
        <field name="industry">doors</field>
        <field name="description">
            Template for SolidDoor interior and entrance door range.
            T0: width/height min/max, slab-line compatibility, fire-rated model check.
            T1: hinge count and slab weight from width and model.
            T2: O-variant activation for handle, lock, glass, extras (seal, peephole).
            T3: operation assignment (milling for 3D coatings, fire test for EI60, assembly, finishing).
        </field>
        <field name="constraint_table" eval="
            {
                'nodes': [{
                    'id': 't0-solid',
                    'name': 'T0 Constraints',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'collect',
                        'inputs': [
                            {'id': 'width',      'name': 'width'},
                            {'id': 'height',     'name': 'height'},
                            {'id': 'slab_type',  'name': 'slab_type'},
                            {'id': 'line_type',  'name': 'line_type'},
                            {'id': 'fire_rated', 'name': 'fire_rated'},
                            {'id': 'door_model', 'name': 'door_model'}
                        ],
                        'outputs': [
                            {'id': 'level',   'name': 'level'},
                            {'id': 'message', 'name': 'message'}
                        ],
                        'rules': [
                            {'width': '&lt; 600', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Width must be at least 600 mm for a standard interior door.&quot;'},
                            {'width': '&gt; 1100', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Width above 1100 mm requires custom project — not configurable as standard.&quot;'},
                            {'width': '', 'height': '&lt; 1900', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Height must be at least 1900 mm.&quot;'},
                            {'width': '', 'height': '&gt; 2400', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Height above 2400 mm requires custom project.&quot;'},
                            {'width': '', 'height': '', 'slab_type': '&quot;Без&quot;', 'line_type': '!= &quot;Без&quot;', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;error&quot;', 'message': '&quot;Slab Без cannot have decorative lines — set line_type to Без.&quot;'},
                            {'width': '', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': 'true', 'door_model': '&quot;iDoor&quot;,&quot;iDoor_3_0&quot;,&quot;B_Smart&quot;',
                             'level': '&quot;error&quot;', 'message': '&quot;Fire-rated variant not available for this model — use Klasik EI60 series.&quot;'},
                            {'width': '&gt; 1000', 'height': '', 'slab_type': '', 'line_type': '', 'fire_rated': '', 'door_model': '',
                             'level': '&quot;warning&quot;', 'message': '&quot;Width &gt; 1000 mm: requires 3 hinges instead of 2.&quot;'}
                        ]
                    }
                }]
            }
        "/>
        <field name="geometry_table" eval="
            {
                'nodes': [{
                    'id': 't1-solid',
                    'name': 'T1 Geometry - weight and hinge count',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'first',
                        'inputs': [
                            {'id': 'width',      'name': 'width'},
                            {'id': 'door_model', 'name': 'door_model'}
                        ],
                        'outputs': [
                            {'id': 'hinge_count',    'name': 'hinge_count'},
                            {'id': 'slab_weight_kg', 'name': 'slab_weight_kg'}
                        ],
                        'rules': [
                            {'width': '&gt; 1000', 'door_model': '&quot;Klasik_EI60&quot;,&quot;Klasik_EI60i&quot;', 'hinge_count': '4', 'slab_weight_kg': '45'},
                            {'width': '&gt; 1000', 'door_model': '',                                              'hinge_count': '3', 'slab_weight_kg': '35'},
                            {'width': '',          'door_model': '&quot;Klasik_EI60&quot;,&quot;Klasik_EI60i&quot;', 'hinge_count': '3', 'slab_weight_kg': '38'},
                            {'width': '',          'door_model': '',                                              'hinge_count': '2', 'slab_weight_kg': '28'}
                        ]
                    }
                }]
            }
        "/>
        <field name="material_table" eval="
            {
                'nodes': [{
                    'id': 't2-solid',
                    'name': 'T2 Materials - O-variant activation',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'collect',
                        'inputs': [
                            {'id': 'handle_type', 'name': 'handle_type'},
                            {'id': 'lock_type',   'name': 'lock_type'},
                            {'id': 'extras',      'name': 'extras'},
                            {'id': 'has_glass',   'name': 'has_glass'}
                        ],
                        'outputs': [
                            {'id': 'component', 'name': 'component'},
                            {'id': 'coeff',     'name': 'coeff'}
                        ],
                        'rules': [
                            {'handle_type': '!= &quot;&quot;', 'lock_type': '',             'extras': '',                          'has_glass': '',     'component': '&quot;handle-o&quot;',  'coeff': '1'},
                            {'handle_type': '',              'lock_type': '!= &quot;&quot;', 'extras': '',                          'has_glass': '',     'component': '&quot;lock-o&quot;',    'coeff': '1'},
                            {'handle_type': '',              'lock_type': '',               'extras': 'contains &quot;seal&quot;',  'has_glass': '',     'component': '&quot;seal-o&quot;',    'coeff': '1'},
                            {'handle_type': '',              'lock_type': '',               'extras': 'contains &quot;peephole&quot;', 'has_glass': '',  'component': '&quot;peephole-o&quot;', 'coeff': '1'},
                            {'handle_type': '',              'lock_type': '',               'extras': '',                          'has_glass': 'true', 'component': '&quot;glass-o&quot;',   'coeff': '1'}
                        ]
                    }
                }]
            }
        "/>
        <field name="operation_table" eval="
            {
                'nodes': [{
                    'id': 't3-solid',
                    'name': 'T3 Operations',
                    'type': 'decisionTable',
                    'content': {
                        'hitPolicy': 'collect',
                        'inputs': [
                            {'id': 'coating',    'name': 'coating'},
                            {'id': 'fire_rated', 'name': 'fire_rated'},
                            {'id': 'door_model', 'name': 'door_model'}
                        ],
                        'outputs': [
                            {'id': 'workcenter_code', 'name': 'workcenter_code'},
                            {'id': 'duration_min',    'name': 'duration_min'}
                        ],
                        'rules': [
                            {'coating': 'contains &quot;3D&quot;', 'fire_rated': '',     'door_model': '', 'workcenter_code': '&quot;SDMILL&quot;', 'duration_min': '20'},
                            {'coating': '',                        'fire_rated': 'true', 'door_model': '', 'workcenter_code': '&quot;SDFIRE&quot;', 'duration_min': '30'},
                            {'coating': '',                        'fire_rated': '',     'door_model': '', 'workcenter_code': '&quot;SDASM&quot;',  'duration_min': '45'},
                            {'coating': '',                        'fire_rated': '',     'door_model': '', 'workcenter_code': '&quot;SDFIN&quot;',  'duration_min': '25'}
                        ]
                    }
                }]
            }
        "/>
    </record>
</odoo>
