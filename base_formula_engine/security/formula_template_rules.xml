<odoo noupdate="1">

    <!-- Multi-company: потребителят вижда шаблони на разрешените си
         фирми или глобални (без фирма) шаблони. -->
    <record id="formula_template_multi_company_rule" model="ir.rule">
        <field name="name">Formula Template multi-company</field>
        <field name="model_id" ref="model_formula_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

</odoo>
