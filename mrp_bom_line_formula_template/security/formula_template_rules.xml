<odoo noupdate="1">

    <!-- Multi-company rule: a user can only see templates of their
         allowed companies, or company-less (global) templates. -->
    <record id="formula_template_multi_company_rule" model="ir.rule">
        <field name="name">Formula Template multi-company</field>
        <field name="model_id" ref="model_mrp_bom_line_formula_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

</odoo>
