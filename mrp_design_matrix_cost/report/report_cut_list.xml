<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_design_cutlist" model="ir.actions.report">
        <field name="name">Cut List</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mrp_design_matrix_cost.report_design_cutlist</field>
        <field name="report_file">mrp_design_matrix_cost.report_design_cutlist</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_design_cutlist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="d" t-value="o.design_cutlist_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Cut List —
                            <span t-field="o.name"/>
                        </h2>
                        <p>
                            <strong>Product: </strong>
                            <span t-field="o.product_id.display_name"/>
                            <span> · </span>
                            <strong>Quantity: </strong>
                            <span t-field="o.product_qty"/>
                            <span t-field="o.product_uom_id.name"/>
                        </p>

                        <t t-if="d['spec']">
                            <h4>Parameters</h4>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Parameter</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="d['spec']" t-as="s">
                                        <td><span t-esc="s['label']"/></td>
                                        <td><span t-esc="s['value']"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <h4>Cutting materials</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit</th>
                                    <th class="text-end">Loss</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['lines']" t-as="l">
                                    <td><span t-esc="l['product_name']"/></td>
                                    <td class="text-end">
                                        <span t-esc="round(l['qty'], 3)"/>
                                    </td>
                                    <td><span t-esc="l.get('uom') or ''"/></td>
                                    <td class="text-end">
                                        <span t-esc="round((l.get('loss') or 0.0) * 100, 1)"/>%
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <p t-if="not d['lines']" class="text-muted">
                            No materials to display (no matrix/lot/context).
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
