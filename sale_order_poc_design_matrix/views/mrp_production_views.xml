<odoo>
    <!-- Матричното MO не се преразгъва по POC (ADR solid55-poc-design/0001, т. 6) -->
    <record id="mrp_production_form_view_poc_matrix" model="ir.ui.view">
        <field name="name">mrp.production.form.poc.matrix</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="sale_order_poc_mrp.mrp_production_form_view_poc"/>
        <field name="arch" type="xml">
            <button name="action_poc_recompute" position="attributes">
                <attribute name="invisible">not poc_id or poc_matrix_driven or state not in ('confirmed', 'progress', 'to_close')</attribute>
            </button>
            <field name="poc_id" position="after">
                <field name="poc_matrix_driven" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
