     Техническо ниво: собствено таблет-меню (опашка от design lot-ове
     със sales_confirmed) + технически бутони на lot формата. Генерично,
     param-driven — нивата идват от param_levels. Групите/design_state са
     в sale_design_configurator.
-->
<odoo>

    <!-- Technical workflow buttons on the design lot form -->
    <record id="stock_lot_form_technical" model="ir.ui.view">
        <field name="name">stock.lot.form.technical</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <!-- Бутоните отиват в хедъра (създаден от sales view-то stock_lot_form_design_sales) -->
            <xpath expr="//header" position="inside">
                <button name="action_open_design_technical" type="object"
                        string="Fill Technical Data" class="btn-secondary"
                        invisible="design_state != 'sales_confirmed'"
                        groups="sale_design_configurator.group_design_technical"/>
                <button name="action_design_technical_confirm" type="object"
                        string="Confirm (Technical)" class="oe_highlight"
                        invisible="design_state != 'sales_confirmed'"
                        groups="sale_design_configurator.group_design_technical"/>
                <button name="action_design_reset_to_sales" type="object"
                        string="Reopen (Technical)"
                        invisible="design_state != 'technical_confirmed'"
                        groups="sale_design_configurator.group_design_technical"/>
                <!-- Ако лотът няма залепена SO линия → „Създай СО на база лота" -->
                <field name="design_sale_line_count" invisible="1"/>
                <button name="action_create_sale_order_from_lot" type="object"
                        string="Create Sale Order" class="btn-secondary"
                        invisible="design_sale_line_count != 0 or not design_param_definition_id"
                        groups="sale_design_configurator.group_design_technical"/>
            </xpath>
        </field>
    </record>

    <!-- Tablet-friendly kanban: technical work queue -->
    <record id="view_design_lot_kanban_technical" model="ir.ui.view">
        <field name="name">stock.lot.kanban.technical</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="design_state"
                    default_order="create_date desc">
                <field name="design_state"/>
                <field name="design_param_definition_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-4">
                                        <field name="product_id"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <button name="action_open_design_technical" type="object"
                                        class="btn btn-primary btn-lg w-100">
                                    Fill Technical Data
                                </button>
                            </div>
                            <div class="mt-2">
                                <button name="action_design_technical_confirm" type="object"
                                        class="btn btn-outline-success w-100">
                                    Confirm (Technical)
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tablet-friendly review/input form. Допълва конфигуратора (НЕ го маха):
         същите design параметри, рендерирани като едри полета за таблет. -->
    <record id="view_design_lot_form_tablet" model="ir.ui.view">
        <field name="name">stock.lot.form.tablet.technical</field>
        <field name="model">stock.lot</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form class="o_design_tablet" create="false" duplicate="false">
                <header>
                    <field name="design_state" widget="statusbar"
                           statusbar_visible="draft,sales_confirmed,technical_confirmed"/>
                    <button name="action_open_design_technical" type="object"
                            string="Open Configurator" class="btn-lg btn-secondary"
                            invisible="design_state != 'sales_confirmed'"
                            groups="sale_design_configurator.group_design_technical"/>
                    <button name="action_design_technical_confirm" type="object"
                            string="Confirm (Technical)" class="btn-lg oe_highlight"
                            invisible="design_state != 'sales_confirmed'"
                            groups="sale_design_configurator.group_design_technical"/>
                    <button name="action_design_reset_to_sales" type="object"
                            string="Reopen" class="btn-lg"
                            invisible="design_state != 'technical_confirmed'"
                            groups="sale_design_configurator.group_design_technical"/>
                </header>
                <sheet>
                    <div class="o_design_tablet_head">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="product_id" readonly="1"/></h2>
                    </div>
                    <separator string="Design Parameters"/>
                    <!-- Полетата на дизайна, рендерирани едро за таблет -->
                    <field name="design_params" nolabel="1"
                           readonly="design_state == 'technical_confirmed'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_design_technical_queue" model="ir.actions.act_window">
        <field name="name">Technical Design</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_design_lot_kanban_technical')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_design_lot_form_tablet')})]"/>
        <field name="domain">[('design_param_definition_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No design lots awaiting technical input</p>
            <p>Design lots confirmed by sales appear here for the technical person to complete.</p>
        </field>
    </record>

    <menuitem id="menu_technical_design_root"
              name="Technical Design"
              web_icon="stock,static/description/icon.png"
              groups="sale_design_configurator.group_design_technical"
              sequence="55"/>
    <menuitem id="menu_technical_design_queue"
              parent="menu_technical_design_root"
              action="action_design_technical_queue"
              groups="sale_design_configurator.group_design_technical"
              sequence="10"/>

</odoo>
