<odoo>
    <record id="sale_order_poc_param_view_form_drawing" model="ir.ui.view">
        <field name="name">sale.order.poc.param.form.drawing</field>
        <field name="model">sale.order.poc.param</field>
        <field name="inherit_id" ref="sale_order_poc.sale_order_poc_param_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='option_ids']/list/field[@name='color']" position="after">
                <field name="drawing_color" widget="color" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
