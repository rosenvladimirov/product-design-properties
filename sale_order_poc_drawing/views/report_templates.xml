<odoo>
    <!-- Рисунката за PDF-ите: t-call с `poc`. wkhtmltopdf свива SVG без
         височина до 0 — затова фиксиран размер (SPEC § 3.4). -->
    <template id="poc_drawing_block">
        <t t-set="poc_drawing" t-value="poc._poc_drawing()"/>
        <div t-if="poc_drawing" class="o_poc_drawing_block">
            <style>.o_poc_drawing_block svg { width: 90mm; height: 55mm; }</style>
            <img t-if="poc_drawing.get('url')" t-att-src="poc_drawing['url']"
                 style="max-width: 90mm; max-height: 55mm;" alt=""/>
            <t t-else="" t-out="poc_drawing.get('svg')"/>
            <div t-if="poc_drawing.get('caption')" class="o_poc_drawing_caption small text-muted"
                 t-out="poc_drawing['caption']"/>
        </div>
    </template>
</odoo>
