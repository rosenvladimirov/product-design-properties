<odoo>
    <record id="product_variant_easy_edit_view_drawing" model="ir.ui.view">
        <field name="name">product.product.view.form.easy.drawing</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='codes']" position="inside">
                <field name="drawing_color" widget="color"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_drawing" model="ir.ui.view">
        <field name="name">product.product.form.drawing</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="drawing_color" widget="color"/>
            </xpath>
        </field>
    </record>
</odoo>
