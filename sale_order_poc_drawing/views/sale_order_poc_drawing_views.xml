<odoo>
    <record id="sale_order_poc_drawing_view_list" model="ir.ui.view">
        <field name="name">sale.order.poc.drawing.list</field>
        <field name="model">sale.order.poc.drawing</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="parameter_codes" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sale_order_poc_drawing_view_form" model="ir.ui.view">
        <field name="name">sale.order.poc.drawing.form</field>
        <field name="model">sale.order.poc.drawing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Door — front view"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parameter_codes" placeholder="width, height, opening"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="sample_values_text" placeholder='{"width": 900, "height": 2000}'/>
                        </group>
                    </group>
                    <!-- редакторът вляво, прегледът по sample_values вдясно — сменя се веднага -->
                    <div class="row">
                        <div class="col-lg-7">
                            <field name="svg" widget="code" options="{'mode': 'xml'}" nolabel="1"/>
                        </div>
                        <div class="col-lg-5">
                            <field name="preview" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_order_poc_drawing_view_search" model="ir.ui.view">
        <field name="name">sale.order.poc.drawing.search</field>
        <field name="model">sale.order.poc.drawing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="sale_order_poc_drawing_action" model="ir.actions.act_window">
        <field name="name">Product Drawings</field>
        <field name="res_model">sale.order.poc.drawing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
