<odoo>
    <record id="view_production_lot_form_inherit_sale_order_poc" model="ir.ui.view">
        <field name="name">stock.lot.form.sale.order.poc</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="poc_id" invisible="not poc_id"/>
                <field name="poc_batch" invisible="not poc_id"/>
                <field name="poc_summary" invisible="not poc_id"/>
            </xpath>
        </field>
    </record>
</odoo>
