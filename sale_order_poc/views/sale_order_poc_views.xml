<odoo>
    <record id="sale_order_poc_view_list" model="ir.ui.view">
        <field name="name">sale.order.poc.list</field>
        <field name="model">sale.order.poc</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="template_id"/>
                <field name="summary"/>
                <field name="lot_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="sale_order_poc_view_form" model="ir.ui.view">
        <field name="name">sale.order.poc.form</field>
        <field name="model">sale.order.poc</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_release" type="object" string="Release to Production"
                            class="oe_highlight" invisible="not release_needed"/>
                    <button name="action_compute" type="object" string="Compute"
                            invisible="state == 'cancel'"/>
                    <button name="action_reset_to_formula" type="object" string="Reset to Formula"
                            invisible="not manual_params or state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lots" type="object" class="oe_stat_button"
                                icon="fa-barcode" invisible="not lot_count">
                            <field name="lot_count" widget="statinfo" string="Lots"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="summary" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="sale_line_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <label for="product_uom_qty"/>
                            <div class="o_row">
                                <field name="product_uom_qty"/>
                                <field name="product_uom_id"/>
                            </div>
                        </group>
                        <group>
                            <field name="template_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="lot_id"/>
                            <field name="manual_params" invisible="not manual_params"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="can_edit_confirmed" invisible="1"/>
                            <field name="release_needed" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parameters" name="params">
                            <field name="params" nolabel="1" colspan="2" columns="2"
                                   readonly="state == 'cancel' or (state == 'confirmed' and not can_edit_confirmed)"/>
                        </page>
                        <page string="Special Requirements" name="note">
                            <field name="note" nolabel="1"
                                   readonly="state == 'cancel' or (state == 'confirmed' and not can_edit_confirmed)"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sale_order_poc_view_search" model="ir.ui.view">
        <field name="name">sale.order.poc.search</field>
        <field name="model">sale.order.poc</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="summary"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="sale_order_poc_action" model="ir.actions.act_window">
        <field name="name">Production Configurations</field>
        <field name="res_model">sale.order.poc</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No production configuration yet</p>
            <p>A configuration is made from a sale order line whose product has a
               production configuration template.</p>
        </field>
    </record>
</odoo>
