<odoo>
    <record id="product_template_form_view_inherit_sale_order_poc" model="ir.ui.view">
        <field name="name">product.template.form.sale.order.poc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Production Configuration" name="sale_order_poc" invisible="not sale_ok">
                    <group>
                        <field name="poc_template_id" options="{'no_create': True}"/>
                    </group>
                    <field name="poc_default_params" nolabel="1" colspan="2" columns="2"
                           invisible="not poc_template_id"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
