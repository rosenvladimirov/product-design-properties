<odoo>
    <!-- Продавачът работи с конфигурациите; мениджърът пише шаблоните,
         речника и потвърдените конфигурации (ADR sale-order-poc/0009). -->
    <record id="group_poc_user" model="res.groups">
        <field name="name">Production Configuration: User</field>
    </record>
    <record id="group_poc_manager" model="res.groups">
        <field name="name">Production Configuration: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_poc_user'))]"/>
    </record>
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_poc_user'))]"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_poc_manager'))]"/>
    </record>

    <record id="sale_order_poc_company_rule" model="ir.rule">
        <field name="name">Production Configuration: multi-company</field>
        <field name="model_id" ref="model_sale_order_poc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sale_order_poc_template_company_rule" model="ir.rule">
        <field name="name">Production Configuration Template: multi-company</field>
        <field name="model_id" ref="model_sale_order_poc_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
