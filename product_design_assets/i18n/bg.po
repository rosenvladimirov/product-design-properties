#. module: product_design_assets
#: model_terms:ir.ui.view,arch_db:product_design_assets.product_template_form_design_assets
msgid ""
"<i class=\"fa fa-info-circle\"/>\n"
"                        Attach GLB (3D models), SVG (profiles), PNG/JPG (textures) files\n"
"                        on each <strong>product variant</strong> form.\n"
"                        These files are used by the design configurator for 3D visualization."
msgstr ""
"<i class=\"fa fa-info-circle\"/>\n"
"                        Прикачете GLB (3D модели), SVG (профили), PNG/JPG (текстури) файлове\n"
"                        във формуляра на всеки <strong>продуктов вариант</strong>.\n"
"                        Тези файлове се използват от дизайн конфигуратора за 3D визуализация."

