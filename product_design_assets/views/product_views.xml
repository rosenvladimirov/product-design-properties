<odoo>

    <!-- ================================================================ -->
    <!--  product.product form: Design Definition + Properties + Assets    -->
    <!-- ================================================================ -->

    <record id="product_product_form_design_assets" model="ir.ui.view">
        <field name="name">product.product.form.design.assets</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Smart button -->
            <div name="button_box" position="inside">
                <button name="action_view_design_assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cube"
                        invisible="design_asset_count == 0">
                    <field name="design_asset_count" widget="statinfo" string="Design Assets"/>
                </button>
            </div>

            <!-- Design tab in notebook -->
            <notebook position="inside">
                <page string="Design" name="design_properties_page">
                    <!-- Definition dropdown -->
                    <group>
                        <group>
                            <field name="design_param_definition_id"/>
                        </group>
                    </group>

                    <!-- Dynamic properties from definition -->
                    <separator string="Design Properties"
                               invisible="not design_param_definition_id"/>
                    <div class="d-flex" invisible="not design_param_definition_id">
                        <field name="design_properties"
                               class="w-100"
                               columns="2"
                               invisible="not design_param_definition_id"/>
                    </div>

                    <!-- File assets gallery -->
                    <separator string="Design Assets (GLB, SVG, PNG)"/>
                    <field name="design_asset_ids" widget="many2many_binary">
                        <list>
                            <field name="name"/>
                            <field name="mimetype"/>
                            <field name="file_size"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ================================================================ -->
    <!--  product.template form: delegated Design Definition + Properties  -->
    <!-- ================================================================ -->

    <record id="product_template_form_design_assets" model="ir.ui.view">
        <field name="name">product.template.form.design.assets</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Design" name="design_properties_page">
                    <!-- Definition dropdown -->
                    <group>
                        <group>
                            <field name="design_param_definition_id"/>
                        </group>
                    </group>

                    <!-- Dynamic properties from definition -->
                    <separator string="Design Properties"
                               invisible="not design_param_definition_id"/>
                    <div class="d-flex" invisible="not design_param_definition_id">
                        <field name="design_properties"
                               class="w-100"
                               columns="2"
                               invisible="not design_param_definition_id"/>
                    </div>

                    <!-- Info about variant-level assets -->
                    <separator string="Design Assets"/>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        Attach GLB (3D models), SVG (profiles), PNG/JPG (textures) files
                        on each <strong>product variant</strong> form.
                        These files are used by the design configurator for 3D visualization.
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ================================================================ -->
    <!--  product.template list: optional design definition column         -->
    <!-- ================================================================ -->

    <record id="product_template_list_design" model="ir.ui.view">
        <field name="name">product.template.list.design</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="design_param_definition_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
