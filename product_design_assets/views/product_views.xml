<odoo>

    <!-- Smart button on product.product form -->
    <record id="product_product_form_design_assets" model="ir.ui.view">
        <field name="name">product.product.form.design.assets</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_design_assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cube"
                        invisible="design_asset_count == 0">
                    <field name="design_asset_count" widget="statinfo" string="Design Assets"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Design Assets" name="design_assets">
                    <field name="design_asset_ids" widget="many2many_binary">
                        <list>
                            <field name="name"/>
                            <field name="mimetype"/>
                            <field name="file_size"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- product.template form: Design Assets tab with info -->
    <record id="product_template_form_design_assets" model="ir.ui.view">
        <field name="name">product.template.form.design.assets</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Design Assets" name="design_assets">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        Attach GLB (3D models), SVG (profiles), PNG/JPG (textures) files
                        to each <strong>product variant</strong>. Open the variant form to manage assets.
                        These files are used by the design configurator for 3D visualization.
                    </div>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
