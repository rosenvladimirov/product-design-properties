{
  "nodes": [
    {
      "id": "t0-bags",
      "name": "T0 Constraints",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "bag_type", "name": "bag_type"},
          {"id": "has_tie",  "name": "has_tie"}
        ],
        "outputs": [
          {"id": "level",   "name": "level"},
          {"id": "message", "name": "message"}
        ],
        "rules": [
          {
            "bag_type": "\"sheet\"",
            "has_tie":  "true",
            "level":    "\"warning\"",
            "message":  "\"Sheet bag with tie: splitting operation will be skipped — fold only.\""
          }
        ]
      }
    },
    {
      "id": "t1-bags",
      "name": "T1 Geometry",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "first",
        "inputs": [
          {"id": "bag_type", "name": "bag_type"},
          {"id": "has_tie",  "name": "has_tie"}
        ],
        "outputs": [
          {"id": "effective_length_expr", "name": "effective_length_expr"},
          {"id": "layers",                "name": "layers"}
        ],
        "rules": [
          {
            "bag_type": "\"sleeve\"",
            "has_tie":  "true",
            "effective_length_expr": "\"(height + 50) * 2\"",
            "layers": "2"
          },
          {
            "bag_type": "\"sleeve\"",
            "has_tie":  "false",
            "effective_length_expr": "\"height * 2\"",
            "layers": "2"
          },
          {
            "bag_type": "\"sheet\"",
            "has_tie":  "true",
            "effective_length_expr": "\"(height + 50) * 1\"",
            "layers": "1"
          },
          {
            "bag_type": "\"sheet\"",
            "has_tie":  "false",
            "effective_length_expr": "\"height * 1\"",
            "layers": "1"
          }
        ]
      }
    },
    {
      "id": "t2-bags",
      "name": "T2 Materials",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "has_print", "name": "has_print"},
          {"id": "color",     "name": "color"},
          {"id": "has_tie",   "name": "has_tie"}
        ],
        "outputs": [
          {"id": "bom_line_coeff_key", "name": "bom_line_coeff_key"},
          {"id": "coefficient",        "name": "coefficient"},
          {"id": "product_tmpl_ref",   "name": "product_tmpl_ref"},
          {"id": "param_attribute_map","name": "param_attribute_map"},
          {"id": "quantity_expr",      "name": "quantity_expr"},
          {"id": "uom_ref",            "name": "uom_ref"}
        ],
        "rules": [
          {
            "has_print": "true",
            "color":     "",
            "has_tie":   "",
            "bom_line_coeff_key":  "\"ink-o\"",
            "coefficient":         "1.0",
            "product_tmpl_ref":    "mrp_design_matrix_bags.product_tmpl_ink",
            "param_attribute_map": "{\"color\": \"mrp_design_matrix_bags.attr_color\"}",
            "quantity_expr":       "\"width * effective_length * 0.000012\"",
            "uom_ref":             "\"uom.product_uom_kg\""
          },
          {
            "has_print": "",
            "color":     "",
            "has_tie":   "true",
            "bom_line_coeff_key":  "",
            "coefficient":         "1.0",
            "product_tmpl_ref":    "mrp_design_matrix_bags.product_tmpl_tie",
            "param_attribute_map": "{}",
            "quantity_expr":       "\"1\"",
            "uom_ref":             "\"uom.product_uom_unit\""
          }
        ]
      }
    },
    {
      "id": "t3-bags",
      "name": "T3 Operations",
      "type": "decisionTable",
      "content": {
        "hitPolicy": "collect",
        "inputs": [
          {"id": "has_tie",  "name": "has_tie"},
          {"id": "bag_type", "name": "bag_type"}
        ],
        "outputs": [
          {"id": "workcenter_ref",    "name": "workcenter_ref"},
          {"id": "name",              "name": "name"},
          {"id": "duration_formula",  "name": "duration_formula"}
        ],
        "rules": [
          {
            "has_tie":  "true",
            "bag_type": "\"sleeve\"",
            "workcenter_ref":   "\"mrp_design_matrix_bags.wc_slitting\"",
            "name":             "\"Slitting\"",
            "duration_formula": "\"qty * 0.5\""
          },
          {
            "has_tie":  "true",
            "bag_type": "",
            "workcenter_ref":   "\"mrp_design_matrix_bags.wc_tie_insertion\"",
            "name":             "\"Tie insertion\"",
            "duration_formula": "\"qty * 0.3\""
          }
        ]
      }
    }
  ]
}
